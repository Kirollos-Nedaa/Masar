
/* ── Footer ────────────────────────────────────────────────── */
.footer {
    background-color: var(--dark);
    padding: 2rem 0 1rem;
}

.footer-brand {
    font-family: 'Sora', sans-serif;
    font-size: 2rem;
    font-weight: 800;
    color: var(--white);
    text-decoration: none;
    letter-spacing: -.03em;
}

.footer-brand .dot {
    color: var(--blue);
}

.footer-heading {
    font-weight: 600;
    color: var(--white);
    margin-bottom: 1rem;
    font-size: 1.125rem;
}

.footer-link {
    color: rgba(var(--white-rgb), 0.7);
    text-decoration: none;
    font-size: 0.875rem;
    display: block;
    margin-bottom: 0.5rem;
    transition: opacity 0.15s ease;
}

.footer-link:hover {
    opacity: 1;
}

.footer-copyright {
    color: rgba(var(--white-rgb), 0.5);
    font-size: 0.875rem;
    text-align: center;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(var(--white-rgb), 0.1);
    margin-top: 2rem;
} ProjectMasarMasarwwwrootcsssite.css
