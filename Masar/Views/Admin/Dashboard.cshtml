@using Masar.Domain.ViewModels.AdminDtos
@model AdminDashboardDto

@{
    ViewData["Title"] = "Admin Dashboard";
    ViewData["HasSidebar"] = true;
}

@section Sidebar {
    <partial name="_AdminSidebar" />
}

@* ── Page header ──────────────────────────────────────────── *@
<div class="page-header d-flex align-items-start justify-content-between">
    <div>
        <h1 class="page-title">Admin Dashboard</h1>
        <p class="page-subtitle">Platform-wide statistics at a glance</p>
    </div>
</div>

@* ── Stats grid (5 items in a single row on extra-large screens) ── *@
<div class="row row-cols-1 row-cols-md-3 row-cols-xl-5 g-3 mb-4">

    @* Total Users *@
    <div class="col">
        <div class="stat-card h-100">
            <div>
                <div class="stat-card-label">Total Users</div>
                <div class="stat-card-value">@Model.TotalUsers</div>
            </div>
            <div class="stat-card-icon stat-icon-blue">
                <span class="iconify stat-icon" data-icon="lucide:users"></span>
            </div>
        </div>
    </div>

    @* Candidates *@
    <div class="col">
        <div class="stat-card h-100">
            <div>
                <div class="stat-card-label">Candidates</div>
                <div class="stat-card-value">@Model.TotalCandidates</div>
            </div>
            <div class="stat-card-icon stat-icon-blue">
                <span class="iconify stat-icon" data-icon="lucide:user"></span>
            </div>
        </div>
    </div>

    @* Companies *@
    <div class="col">
        <div class="stat-card h-100">
            <div>
                <div class="stat-card-label">Companies</div>
                <div class="stat-card-value">@Model.TotalCompanies</div>
            </div>
            <div class="stat-card-icon stat-icon-blue">
                <span class="iconify stat-icon" data-icon="lucide:building-2"></span>
            </div>
        </div>
    </div>

    @* Active Jobs *@
    <div class="col">
        <div class="stat-card h-100">
            <div>
                <div class="stat-card-label">Active Jobs</div>
                <div class="stat-card-value">@Model.ActiveJobs</div>
            </div>
            <div class="stat-card-icon stat-icon-blue">
                <span class="iconify stat-icon" data-icon="lucide:briefcase"></span>
            </div>
        </div>
    </div>

    @* Total Applications *@
    <div class="col">
        <div class="stat-card h-100">
            <div>
                <div class="stat-card-label">Total Apps</div>
                <div class="stat-card-value">@Model.TotalApplications</div>
            </div>
            <div class="stat-card-icon stat-icon-blue">
                <span class="iconify stat-icon" data-icon="lucide:file-text"></span>
            </div>
        </div>
    </div>

</div>

@* ── Recent Activity Tables ───────────────────────────────── *@
<div class="dashboard-activity-grid">

    @* Recent Users *@
    <div class="activity-card">
        <div class="activity-card-header d-flex align-items-center justify-content-between mb-4">
            <h2 class="card-section-title">Recent Users</h2>
            <a href="#" class="card-view-all">
                View All <span class="iconify" data-icon="lucide:arrow-right"></span>
            </a>
        </div>

        <div class="activity-list">
            @if (Model.RecentUsers?.Any() == true)
            {
                for (int i = 0; i < Model.RecentUsers.Count; i++)
                {
                    var user = Model.RecentUsers[i];
                    var borderStyle = (i == Model.RecentUsers.Count - 1) ? "" : "border-bottom: 1px solid #e5e7eb;";

                    <div class="activity-row d-flex align-items-center justify-content-between" style="@borderStyle">
                        <div class="activity-info">
                            <h3 class="job-table-title">@user.Name</h3>
                            <p class="table-meta-text mb-1">@user.Email &bull; @user.Role</p>
                            <p class="table-meta-text">Joined @user.CreatedAt</p>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="activity-empty text-muted">No recent users found.</div>
            }
        </div>
    </div>

    @* Recent Posts *@
    <div class="activity-card">
        <div class="activity-card-header d-flex align-items-center justify-content-between mb-4">
            <h2 class="card-section-title">Recent Job Posts</h2>
            <a href="#" class="card-view-all">
                View All <span class="iconify" data-icon="lucide:arrow-right"></span>
            </a>
        </div>

        <div class="activity-list">
            @if (Model.RecentPosts?.Any() == true)
            {
                for (int i = 0; i < Model.RecentPosts.Count; i++)
                {
                    var job = Model.RecentPosts[i];
                    var borderStyle = (i == Model.RecentPosts.Count - 1) ? "" : "border-bottom: 1px solid #e5e7eb;";

                    <div class="activity-row d-flex align-items-center justify-content-between" style="@borderStyle">
                        <div class="activity-info">
                            <h3 class="job-table-title">@job.Title</h3>
                            <p class="table-meta-text mb-1">@job.CompanyName</p>
                            <p class="table-meta-text">Posted @job.PostedDate</p>
                        </div>
                        <div class="activity-actions d-flex align-items-center gap-3">
                            @if (job.Status == "Active")
                            {
                                <span class="status-badge badge-accepted">Active</span>
                            }
                            else
                            {
                                <span class="status-badge badge-rejected">Closed</span>
                            }
                            <a asp-controller="Jobs" asp-action="Details" asp-route-id="@job.Id" class="btn-table-action"> View </a>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="activity-empty text-muted">No recent posts found.</div>
            }
        </div>
    </div>

</div>