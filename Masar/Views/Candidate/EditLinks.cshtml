@model Masar.Domain.ViewModels.CandidateDtos.CandidateProfileDto

@{
    ViewData["Title"] = "Professional Links";
    ViewData["HasSidebar"] = true;
}

@section Sidebar {
    <partial name="_CandidateSidebar" />
}

@* ── Page Header ──────────────────────────────────────────── *@
<div class="page-header d-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="page-title">Professional Links</h1>
        <p class="page-subtitle">Add links to your profiles and portfolio</p>
    </div>
    <a asp-controller="Candidate" asp-action="Profile" class="btn-outline-app">
        <span class="iconify" data-icon="lucide:arrow-left"></span> Back to Profile
    </a>
</div>

<form asp-controller="Candidate" asp-action="UpdateLinks" method="post" id="linksForm">
    @Html.AntiForgeryToken()

    <div class="app-card mb-4">
        <div class="card-section-header">
            <div class="card-section-title">
                <span class="iconify me-2" data-icon="lucide:link"></span>
                Your Links
            </div>
        </div>

        @* ── Saved Links List — rendered by JS ────────────── *@
        <div id="linksContainer"></div>

        @* ── Add Link Row ─────────────────────────────────── *@
        <div class="add-link-row mt-3">

            @* ── Custom Dropdown for Link Type ── *@
            <div class="link-type-wrap" style="flex: 0 0 160px;">
                <div class="custom-dropdown position-relative w-100" id="linkTypeWrap">
                    <input type="hidden" id="addLinkType" value="1" onchange="updateAddIcon()" />
                    <button type="button" class="custom-dropdown-toggle epi-input d-flex align-items-center justify-content-between w-100 text-start" onclick="toggleCustomSelect(event, 'linkTypeMenu')">
                        <span class="icon-text-wrap d-flex align-items-center gap-2">
                            <span class="iconify display-icon" data-icon="simple-icons:linkedin" style="color:#0A66C2;"></span>
                            <span class="display-text" style="font-size:0.875rem;">LinkedIn</span>
                        </span>
                        <span class="iconify chevron text-muted" data-icon="lucide:chevron-down"></span>
                    </button>
                    <div class="custom-dropdown-menu w-100" id="linkTypeMenu">
                        <div class="dropdown-scroll-area p-1">
                            <div class="custom-dropdown-item selected" onclick="selectLinkTypeOption(event, 1, 'LinkedIn', 'simple-icons:linkedin', '#0A66C2')">
                                <span class="iconify ind-icon" data-icon="simple-icons:linkedin" style="color:#0A66C2;"></span>
                                <span class="ind-name">LinkedIn</span>
                            </div>
                            <div class="custom-dropdown-item" onclick="selectLinkTypeOption(event, 2, 'GitHub', 'simple-icons:github', '#24292E')">
                                <span class="iconify ind-icon" data-icon="simple-icons:github" style="color:#24292E;"></span>
                                <span class="ind-name">GitHub</span>
                            </div>
                            <div class="custom-dropdown-item" onclick="selectLinkTypeOption(event, 3, 'Portfolio', 'lucide:globe', '#2563EB')">
                                <span class="iconify ind-icon" data-icon="lucide:globe" style="color:#2563EB;"></span>
                                <span class="ind-name">Portfolio</span>
                            </div>
                            @if (ViewData["Title"].ToString() == "Company Links")
                            {
                                <div class="custom-dropdown-item" onclick="selectLinkTypeOption(event, 4, 'Website', 'lucide:building-2', '#64748B')">
                                    <span class="iconify ind-icon" data-icon="lucide:building-2" style="color:#64748B;"></span>
                                    <span class="ind-name">Website</span>
                                </div>
                                <div class="custom-dropdown-item" onclick="selectLinkTypeOption(event, 5, 'Other', 'lucide:link', '#64748B')">
                                    <span class="iconify ind-icon" data-icon="lucide:link" style="color:#64748B;"></span>
                                    <span class="ind-name">Other</span>
                                </div>
                            }
                            else
                            {
                                <div class="custom-dropdown-item" onclick="selectLinkTypeOption(event, 4, 'Other', 'lucide:link', '#64748B')">
                                    <span class="iconify ind-icon" data-icon="lucide:link" style="color:#64748B;"></span>
                                    <span class="ind-name">Other</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <input type="text" id="addLinkUrl" class="epi-input" placeholder="https://..." />
            <button type="button" class="btn-primary-app" onclick="addLink()">
                <span class="iconify" data-icon="lucide:plus"></span> Add
            </button>
        </div>
        <p id="addLinkError" class="epi-error" style="display:none;">
            Please enter a valid URL starting with https://
        </p>

    </div>

    @* Hidden inputs injected by JS before submit *@
    <div id="hiddenInputs"></div>

    @* ── Actions ──────────────────────────────────────────── *@
    <div class="d-flex justify-content-end gap-2">
        <a asp-controller="Candidate" asp-action="Profile" class="btn-outline-app">
            Cancel
        </a>
        <button type="submit" class="btn-primary-app">
            <span class="iconify" data-icon="lucide:save"></span> Save Links
        </button>
    </div>

</form>

@section Scripts {
    <script>
        const iconMap = {
            1: { icon: 'simple-icons:linkedin',  label: 'LinkedIn',        color: '#0A66C2' },
            2: { icon: 'simple-icons:github',    label: 'GitHub',          color: '#24292E' },
            3: { icon: 'lucide:globe',           label: 'Portfolio',       color: '#2563EB' },
            4: { icon: 'lucide:link',            label: 'Other',           color: '#64748B' },
        };

        // Seed existing links from server
        let links = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            Model.ProfessionalLinks?.Select(l => new
            {
                id = l.Id,
                linkName = (int)l.LinkName,
                url = l.Url
            })
        ))

        // ── Render saved links list ───────────────────────────────
        function renderLinks() {
            const container = document.getElementById('linksContainer');

            if (links.length === 0) {
                container.innerHTML = `
                    <p class="text-muted mb-3" style="font-size:.875rem;">
                        No links added yet. Use the form below to add your first link.
                    </p>`;
                return;
            }

            container.innerHTML = links.map((l, i) => {
                const meta = iconMap[l.linkName] ?? iconMap[5];
                return `
                    <div class="saved-link-row">
                        <div class="saved-link-icon-wrap">
                            <span class="iconify"
                                  data-icon="${meta.icon}"
                                  style="color:${meta.color};width:1.1rem;height:1.1rem;"></span>
                        </div>
                        <span class="saved-link-name">${meta.label}</span>
                        <a href="${l.url}" target="_blank" class="saved-link-url">${l.url}</a>
                        <button type="button" class="btn-icon-danger" onclick="removeLink(${i})">
                            <span class="iconify" data-icon="lucide:x"></span>
                        </button>
                    </div>`;
            }).join('');

            Iconify.scan(container);
        }

        // ── Update icon slot when dropdown changes ────────────────
        function updateAddIcon() {
            const type = parseInt(document.getElementById('addLinkType').value);
            const meta = iconMap[type] ?? iconMap[5];
            const slot = document.getElementById('addLinkIconSlot');
            slot.innerHTML = `
                <span class="iconify"
                      data-icon="${meta.icon}"
                      style="color:${meta.color};width:1.1rem;height:1.1rem;"></span>`;
            Iconify.scan(slot);
        }

        // ── Add link ──────────────────────────────────────────────
        function addLink() {
            const type = parseInt(document.getElementById('addLinkType').value);
            const url  = document.getElementById('addLinkUrl').value.trim();
            const err  = document.getElementById('addLinkError');

            if (!url || !url.startsWith('http')) {
                err.style.display = 'block';
                return;
            }

            err.style.display = 'none';
            links.push({ id: null, linkName: type, url });
            document.getElementById('addLinkUrl').value = '';
            renderLinks();
        }

        // ── Remove link ───────────────────────────────────────────
        function removeLink(index) {
            links.splice(index, 1);
            renderLinks();
        }

        // ── Inject hidden inputs before submit ────────────────────
        document.getElementById('linksForm').addEventListener('submit', () => {
            const container = document.getElementById('hiddenInputs');
            container.innerHTML = links.map((l, i) => `
                <input type="hidden" name="links[${i}].Id"       value="${l.id ?? ''}" />
                <input type="hidden" name="links[${i}].LinkName" value="${l.linkName}" />
                <input type="hidden" name="links[${i}].Url"      value="${l.url}" />
            `).join('');
        });

        // ── Enter key on URL input ────────────────────────────────
        document.getElementById('addLinkUrl').addEventListener('keydown', (e) => {
            if (e.key === 'Enter') { e.preventDefault(); addLink(); }
        });

        // Init
        renderLinks();

        // ── Custom Dropdown Logic ─────────────────────────────────
        function toggleCustomSelect(event, menuId) {
            event.preventDefault();
            event.stopPropagation();
            document.querySelectorAll('.custom-dropdown-menu.show').forEach(m => {
                if (m.id !== menuId) m.classList.remove('show');
            });
            document.getElementById(menuId).classList.toggle('show');
        }

        function selectLinkTypeOption(event, value, text, icon, color) {
            event.stopPropagation();
            const wrap = document.getElementById('linkTypeWrap');

            const hiddenInput = document.getElementById('addLinkType');
            hiddenInput.value = value;

            wrap.querySelector('.display-text').innerText = text;
            const iconEl = wrap.querySelector('.display-icon');
            iconEl.setAttribute('data-icon', icon);
            iconEl.style.color = color;

            wrap.querySelectorAll('.custom-dropdown-item').forEach(el => el.classList.remove('selected'));
            event.currentTarget.classList.add('selected');

            wrap.querySelector('.custom-dropdown-menu').classList.remove('show');
            if (typeof Iconify !== 'undefined') Iconify.scan(wrap);
        }

        window.addEventListener('click', function(e) {
            if (!e.target.closest('.custom-dropdown')) {
                document.querySelectorAll('.custom-dropdown-menu.show').forEach(m => m.classList.remove('show'));
            }
        });
    </script>
}