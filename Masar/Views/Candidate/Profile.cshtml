@model Masar.Domain.ViewModels.CandidateDtos.CandidateProfileDto

@{
    ViewData["Title"] = "My Profile";
    ViewData["HasSidebar"] = true;
}

@section Sidebar {
<partial name="_CandidateSidebar" />
}

@* ── Page Header ──────────────────────────────────────────── *@
<div class="page-header d-flex align-items-center justify-content-between">
    <div>
        <h1 class="page-title">My Profile</h1>
        <p class="page-subtitle">Your professional information visible to companies</p>
    </div>
</div>

@* ── Personal Information ─────────────────────────────────── *@
@functions {
    string MissingLabel(bool condition) => condition ? "field-missing-label" : "";
    string MissingValue(bool condition) => condition ? "field-missing-value" : "";
    string DisplayOrDefault(string value) => string.IsNullOrWhiteSpace(value) ? "Not provided" : value;
}

<div class="app-card mb-4">
    <div class="card-section-header">
        <div class="card-section-title">
            <span class="iconify" data-icon="lucide:user"></span>
            Personal Information
        </div>
        <a asp-controller="Candidate" asp-action="EditPersonalInfo" class="btn-edit-section">
            <span class="iconify" data-icon="lucide:square-pen"></span> Edit
        </a>
    </div>

    @* Row 1 — First Name, Last Name *@
    <div class="row g-3 mb-3">
        @{
            var firstMissing = string.IsNullOrWhiteSpace(Model.FirstName);
            var lastMissing = string.IsNullOrWhiteSpace(Model.LastName);
        }

        <div class="col-12 col-sm-6">
            <div class="profile-field-label @MissingLabel(firstMissing)">First Name</div>
            <div class="profile-field-value @MissingValue(firstMissing)">
                @DisplayOrDefault(Model.FirstName)
            </div>
        </div>

        <div class="col-12 col-sm-6">
            <div class="profile-field-label @MissingLabel(lastMissing)">Last Name</div>
            <div class="profile-field-value @MissingValue(lastMissing)">
                @DisplayOrDefault(Model.LastName)
            </div>
        </div>
    </div>

    @* Row 2 — Gender, Location, Date of Birth *@
    <div class="row g-3 mb-3">
        @{
            var genderMissing = !Model.Gender.HasValue;
            var locationMissing = string.IsNullOrWhiteSpace(Model.Location);
            var dobMissing = !Model.DateOfBirth.HasValue;
        }

        <div class="col-12 col-sm-4">
            <div class="profile-field-label @MissingLabel(genderMissing)">Gender</div>
            <div class="profile-field-value @MissingValue(genderMissing)">
                @(Model.Gender?.ToString() ?? "Not provided")
            </div>
        </div>

        <div class="col-12 col-sm-4">
            <div class="profile-field-label @MissingLabel(locationMissing)">Location</div>
            <div class="profile-field-value @MissingValue(locationMissing)">
                @DisplayOrDefault(Model.Location)
            </div>
        </div>

        <div class="col-12 col-sm-4">
            <div class="profile-field-label @MissingLabel(dobMissing)">Date of Birth</div>
            <div class="profile-field-value @MissingValue(dobMissing)">
                @(Model.DateOfBirth?.ToString("MMMM dd, yyyy") ?? "Not provided")
            </div>
        </div>
    </div>

    @* Row 3 — Email, Phone *@
    <div class="row g-3 mb-3">
        @{
            var emailMissing = string.IsNullOrWhiteSpace(Model.Email);
            var phoneMissing = string.IsNullOrWhiteSpace(Model.PhoneNumber);
        }

        <div class="col-12 col-sm-6">
            <div class="profile-field-label @MissingLabel(emailMissing)">Email</div>
            <div class="profile-field-value @MissingValue(emailMissing)">
                @DisplayOrDefault(Model.Email)
            </div>
        </div>

        <div class="col-12 col-sm-6">
            <div class="profile-field-label @MissingLabel(phoneMissing)">Phone Number</div>
            <div class="profile-field-value @MissingValue(phoneMissing)">
                @DisplayOrDefault(Model.PhoneNumber)
            </div>
        </div>
    </div>

    @* Row 4 — Bio *@
    <div class="row g-3">
        @{
            var bioMissing = string.IsNullOrWhiteSpace(Model.Bio);
        }

        <div class="col-12">
            <div class="profile-field-label @MissingLabel(bioMissing)">Bio</div>
            <div class="profile-field-value @MissingValue(bioMissing)">
                @(string.IsNullOrWhiteSpace(Model.Bio) ? "No bio added yet." : Model.Bio)
            </div>
        </div>
    </div>
</div>

@* ── Education ────────────────────────────────────────────── *@
<div class="app-card mb-4">
    <div class="card-section-header">
        <div class="card-section-title">
            <span class="iconify" data-icon="lucide:graduation-cap"></span>
            Education
        </div>
        <a asp-controller="Candidate" asp-action="EditEducation" class="btn-edit-section">
            <span class="iconify" data-icon="lucide:square-pen"></span> Edit
        </a>
    </div>

    @if (Model.Education != null)
    {
        <div class="education-block">
            <div class="education-icon">
                <span class="iconify" data-icon="lucide:school"></span>
            </div>
            <div class="education-details">
                <div class="education-university">@Model.Education.University</div>
                <div class="education-degree">
                    @Model.Education.Degree
                    @if (!string.IsNullOrEmpty(Model.Education.Major))
                    {
                        <span class="text-muted"> &mdash; @Model.Education.Major</span>
                    }
                </div>
                <div class="education-years text-muted" style="font-size:.82rem; margin-top:.25rem;">
                    @if (Model.Education.StartYear.HasValue)
                    {
                        @Model.Education.StartYear.Value.ToString("MM/yyyy")
                    }
                    @if (Model.Education.ExpectedGraduation.HasValue)
                    {
                        <span> &ndash; @Model.Education.ExpectedGraduation.Value.ToString("MM/yyyy")</span>
                    }
                </div>
            </div>
        </div>
    }
    else
    {
        <p class="text-muted mb-0">No education added yet.</p>
    }
</div>

@* ── Skills ───────────────────────────────────────────────── *@
<div class="app-card mb-4">
    <div class="card-section-header">
        <div class="card-section-title">
            <span class="iconify" data-icon="lucide:zap"></span>
            Skills
        </div>
        <a asp-controller="Candidate" asp-action="EditSkills" class="btn-edit-section">
            <span class="iconify" data-icon="lucide:settings-2"></span> Manage Skills
        </a>
    </div>

    @if (Model.SkillNames.Any())
    {
        <div class="d-flex flex-wrap gap-2">
            @foreach (var skill in Model.SkillNames)
            {
                <span class="skill-badge">@skill</span>
            }
        </div>
    }
    else
    {
        <p class="text-muted mb-0">No skills added yet.
            <a asp-controller="Candidate" asp-action="EditSkills">Add your first skill</a>
        </p>
    }
</div>

@* ── Resume ───────────────────────────────────────────────── *@
<div class="app-card mb-4">
    <div class="card-section-header">
        <div class="card-section-title">
            <span class="iconify" data-icon="lucide:file-user"></span>
            Resume
        </div>
        @if (!string.IsNullOrEmpty(Model.ResumeUrl))
        {
            <div class="d-flex gap-2">
                <button type="button" class="btn-outline-app btn-sm-app" onclick="document.getElementById('resumeUpdateInput').click()">
                    <span class="iconify" data-icon="lucide:upload-cloud"></span> Update
                </button>
                <button type="button" class="btn-outline-app btn-sm-app text-danger border-danger" onclick="confirmDeleteResume()">
                    <span class="iconify" data-icon="lucide:trash-2"></span> Delete
                </button>
            </div>
            <input type="file" id="resumeUpdateInput" accept=".pdf,.doc,.docx" hidden onchange="uploadResumeFile(this.files[0])" />
        }
    </div>

    @if (!string.IsNullOrEmpty(Model.ResumeUrl))
    {
        <div class="resume-row">
            <span class="iconify resume-icon" data-icon="lucide:file-text"></span>
            <div class="resume-info">
                <div class="resume-name">@Model.ResumeOriginalName</div>
                <div class="resume-meta text-muted">Uploaded @Model.ResumeUploadedAt</div>
            </div>
            <a href="@Model.ResumeUrl" target="_blank" class="btn-outline-app btn-sm-app">
                <span class="iconify" data-icon="lucide:eye"></span> View
            </a>
        </div>
        <div class="masar-progress-container mt-3" id="resumeProgressContainer" style="display:none;">
            <div class="masar-progress-bar" id="resumeProgressBar"></div>
        </div>
    }
    else
    {
        <div class="resume-upload-zone" id="resumeDropZone">
            <input type="file" id="resumeInput" name="Resume" accept=".pdf,.doc,.docx" hidden onchange="uploadResumeFile(this.files[0])" />
            <span class="iconify resume-upload-icon" data-icon="lucide:upload"></span>
            <p class="mb-1">Drop your resume here or click to browse</p>
            <p class="text-muted mb-3" style="font-size:.82rem;">PDF, DOC, DOCX (max 5MB)</p>
            <button type="button" class="btn-primary-app btn-sm-app" onclick="document.getElementById('resumeInput').click()">
                <span class="iconify" data-icon="lucide:upload"></span> Upload Resume
            </button>
            <p id="selectedFileName" class="mt-2 text-success"></p>
            <div class="masar-progress-container" id="resumeProgressContainer" style="display:none;">
                <div class="masar-progress-bar" id="resumeProgressBar"></div>
            </div>
        </div>
    }
</div>

@* ── Professional Links ───────────────────────────────────── *@
<div class="app-card mb-4">
    <div class="card-section-header">
        <div class="card-section-title">
            <span class="iconify" data-icon="lucide:link-2"></span>
            Professional Links
        </div>
        <a asp-controller="Candidate" asp-action="EditLinks" class="btn-edit-section">
            <span class="iconify" data-icon="lucide:settings-2"></span> Manage Links
        </a>
    </div>

    @if (Model.ProfessionalLinks.Any())
    {
        <div class="d-flex flex-column gap-2">
            @foreach (var link in Model.ProfessionalLinks)
            {
                string icon = (int)link.LinkName switch
                {
                    1 => "simple-icons:linkedin",
                    2 => "simple-icons:github",
                    3 => "lucide:globe",
                    _ => "lucide:link"
                };
                string color = (int)link.LinkName switch
                {
                    1 => "#0A66C2",
                    2 => "#24292E",
                    3 => "#2563EB",
                    _ => "#64748B"
                };
                string label = (int)link.LinkName switch
                {
                    1 => "LinkedIn",
                    2 => "GitHub",
                    3 => "Portfolio",
                    _ => "Other"
                };

                <div class="d-flex align-items-center">
                    <div class="saved-link-icon-wrap">
                        <span class="iconify"
                        data-icon="@icon"
                        style="color:@color;width:1.1rem;height:1.1rem;"></span>
                    </div>
                    <span class="saved-link-name">@label</span>
                    <a href="@link.Url" target="_blank" class="saved-link-url">@link.Url</a>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-3">
            <span class="iconify"
            data-icon="lucide:link"
            style="width:2rem;height:2rem;color:var(--border);display:block;margin:0 auto .5rem;"></span>
            <p class="text-muted mb-2" style="font-size:.875rem;">No links added yet.</p>
        </div>
    }
</div>

@* ── Connected Service ────────────────────────────────────────────── *@
<div class="app-card mb-4">
    <div class="card-section-header">
        <div class="card-section-title">
            <span class="iconify" data-icon="lucide:shield-check"></span>
            Authentication Methods
        </div>
    </div>

    <div class="d-flex flex-column gap-3 col-12">
        @if (Model.HasLocalPassword)
        {
            <div class="connected-card-row d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-2">
                    <div class="connected-row-icon">
                        <span class="iconify" data-icon="lucide:mail"></span>
                    </div>
                    <div class="d-flex flex-column">
                        <span class="connected-row-title">Email & Password</span>
                    </div>
                </div>
                <span class="iconify connected-chevron-icon" data-icon="lucide:check"></span>
            </div>
        }

        @foreach (var provider in Model.LoginProviders)
        {
            <div class="connected-card-row d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-2">
                    <div class="connected-row-icon">
                        @* Dynamically select the icon based on the provider name *@
                        @if (provider.Equals("Google", StringComparison.OrdinalIgnoreCase))
                        {
                            <span class="iconify" data-icon="flat-color-icons:google"></span>
                        }
                        else if (provider.Equals("GitHub", StringComparison.OrdinalIgnoreCase))
                        {
                            <span class="iconify" data-icon="mdi:github" style="color: #333;"></span>
                        }
                        else
                        {
                            @* Fallback icon for other future providers *@
                            <span class="iconify" data-icon="lucide:key"></span>
                        }
                    </div>
                    <div class="d-flex flex-column">
                        <span class="connected-row-title">@provider</span>
                    </div>
                </div>
                <span class="iconify connected-chevron-icon" data-icon="lucide:check"></span>
            </div>
        }
    </div>
</div>

@* ── Account Management ────────────────────────────────────────────── *@
<div class="app-card mb-4">
    <div class="card-section-header">
        <div class="card-section-title">
            <span class="iconify" data-icon="lucide:activity"></span>
            Account Managemet
        </div>
    </div>

    <div class="d-flex flex-column gap-3 col-12">
        <a asp-controller="Candidate"
           asp-action="ChangePassword"
           class="security-card-row d-flex align-items-center justify-content-between">

            <div class="d-flex align-items-center">
                <div class="security-row-icon">
                    <span class="iconify"
                          data-icon="lucide:lock-keyhole"></span>
                </div>
                <div class="d-flex flex-column">
                    <span class="security-row-title">Change Password</span>
                </div>
            </div>
            <span class="iconify chevron-icon" data-icon="lucide:chevron-right"></span>
        </a>
        <a asp-controller="Candidate" asp-action="DeleteAccount" method="post" class="delete-card-row d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center">
                <div class="delete-row-icon">
                    <span class="iconify"
                          data-icon="lucide:trash-2"></span>
                </div>
                <div class="d-flex flex-column">
                    <span class="delete-row-title">Delete Account</span>
                </div>
            </div>
            <span class="iconify chevron-icon" data-icon="lucide:chevron-right"></span>
        </a>
    </div>
</div>


@* Modal *@
<div class="modal fade review-confirm-modal" id="deleteResumeModal" tabindex="-1" aria-labelledby="deleteResumeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteResumeModalLabel">Delete Resume?</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="review-modal-copy">
                    Are you sure you want to delete your resume?
                </p>
                <p class="review-modal-note mb-0">
                    This action cannot be undone.
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-outline-app" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn-reject" id="confirmDeleteResumeBtn">
                    <span class="iconify" data-icon="lucide:trash-2"></span>
                    Delete Resume
                </button>
            </div>
        </div>
    </div>
</div>

<script>

    function uploadResumeFile(file) {
        if (!file) return;

        // Validation
        const allowedExt = ['.pdf', '.doc', '.docx'];
        const ext = '.' + file.name.split('.').pop().toLowerCase();
        if (!allowedExt.includes(ext)) {
            showToast("Invalid file type. Allowed: PDF, DOC, DOCX", true);
            return;
        }
        if (file.size > 5 * 1024 * 1024) {
            showToast("File size exceeds 5MB limit.", true);
            return;
        }

        const formData = new FormData();
        formData.append("Resume", file);

        const progressContainer = document.getElementById('resumeProgressContainer');
        const progressBar = document.getElementById('resumeProgressBar');
        progressContainer.style.display = 'block';
        progressBar.style.width = '0%';

        const xhr = new XMLHttpRequest();
        xhr.open('POST', '@Url.Action("UploadResume", "Candidate")', true);
        xhr.setRequestHeader('X-Requested-With', 'XMLHttpRequest');

        xhr.upload.onprogress = function(e) {
            if (e.lengthComputable) {
                const percent = Math.round((e.loaded / e.total) * 100);
                progressBar.style.width = percent + '%';
            }
        };

        xhr.onload = function() {
            try {
                const res = JSON.parse(xhr.responseText);
                if (res.success) {
                    showToast(res.message);
                    setTimeout(() => window.location.reload(), 1500);
                } else {
                    showToast(res.message || "Upload failed", true);
                    progressContainer.style.display = 'none';
                }
            } catch {
                showToast("Server error during upload.", true);
                progressContainer.style.display = 'none';
            }
        };
        xhr.onerror = function() { showToast("Network error", true); progressContainer.style.display = 'none'; };
        xhr.send(formData);
    }

    function confirmDeleteResume() {
        var deleteModal = new bootstrap.Modal(document.getElementById('deleteResumeModal'));
        var deleteConfirmBtn = document.getElementById('confirmDeleteResumeBtn');
        deleteModal.show();

        // Remove existing event listeners to avoid multiple triggers
        var oldBtn = deleteConfirmBtn;
        var newBtn = oldBtn.cloneNode(true);
        oldBtn.parentNode.replaceChild(newBtn, oldBtn);
        deleteConfirmBtn = newBtn;

        deleteConfirmBtn.addEventListener('click', function() {
            deleteModal.hide();
            const formData = new FormData();
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            if(token) formData.append('__RequestVerificationToken', token);

            const xhr = new XMLHttpRequest();
            xhr.open('POST', '@Url.Action("DeleteResume", "Candidate")', true);
            xhr.setRequestHeader('X-Requested-With', 'XMLHttpRequest');

            xhr.onload = function() {
                try {
                    const res = JSON.parse(xhr.responseText);
                    if (res.success) {
                        showToast(res.message);
                        setTimeout(() => window.location.reload(), 1000);
                    } else {
                        showToast(res.message || "Delete failed", true);
                    }
                } catch { showToast("Server error.", true); }
            };
            xhr.send(formData);
        });
    }

    // Drag and Drop logic stays the same
    const dropZone = document.getElementById('resumeDropZone');
    if (dropZone) {
        dropZone.addEventListener('dragover', (e) => { e.preventDefault(); dropZone.classList.add('drag-active'); });
        dropZone.addEventListener('dragleave', () => dropZone.classList.remove('drag-active'));
        dropZone.addEventListener('drop', (e) => {
            e.preventDefault();
            dropZone.classList.remove('drag-active');
            if (e.dataTransfer.files.length) uploadResumeFile(e.dataTransfer.files[0]);
        });
    }
</script>