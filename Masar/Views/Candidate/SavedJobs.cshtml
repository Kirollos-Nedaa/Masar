@using Masar.Domain.ViewModels.CandidateDtos
@model List<SavedJobDto>

@{
    ViewData["Title"] = "Saved Jobs";
    ViewData["HasSidebar"] = true;

    string currentSearch = ViewBag.Search as string ?? string.Empty;
    string currentSort = ViewBag.SortBy as string ?? "recent";

    var sortText = currentSort == "oldest" ? "Oldest First" :
                   currentSort == "title" ? "Title (A–Z)" : "Recently Saved";
}

@section Sidebar {
    <partial name="_CandidateSidebar" />
}

@* ── Page Header ──────────────────────────────────────────── *@
<div class="page-header d-flex align-items-center justify-content-between">
    <div>
        <h1 class="page-title">
            <span class="iconify me-2" data-icon="lucide:bookmark-check"
                  style="color:var(--blue);font-size:1.6rem;vertical-align:middle;"></span>
            Saved Jobs
        </h1>
        <p class="page-subtitle">Jobs you've bookmarked for later review</p>
    </div>
</div>

@* ── Search & Filters Form ────────────────────────────────── *@
<form method="get" asp-controller="Candidate" asp-action="SavedJobs" id="filterForm">

    @* Search bar *@
    <div class="jobs-topbar">
        <div class="jobs-search-wrap">
            <span class="iconify jobs-search-icon" data-icon="lucide:search"></span>
            <input type="text"
                   name="search"
                   class="jobs-search-input"
                   placeholder="Search jobs, companies, or keywords..."
                   value="@currentSearch" />
            <button type="submit" class="jobs-search-btn">Search</button>
        </div>
    </div>

    @* Results & Sort bar *@
    <div class="jobs-results-bar" style="margin-top: 1rem; margin-bottom: 1.5rem;">
        <div class="d-flex align-items-center gap-3">
            <span class="jobs-results-count">
                <strong>@Model.Count</strong> Saved Job@(Model.Count != 1 ? "s" : "")
            </span>

            @if (Model.Any())
            {
                <button type="button" class="sj-clear-btn" onclick="confirmClearAll()" style="background: none; border: none; color: var(--danger); font-size: 0.9rem; font-weight: 600; display: flex; align-items: center; gap: 0.4rem;">
                    <span class="iconify" data-icon="lucide:bookmark-x"></span>
                    Clear All
                </button>
            }
        </div>

        <div class="sort-dropdown-wrap" id="sortDropdownWrap">
            <input type="hidden" name="sortBy" id="sortByInput" value="@currentSort" />

            <button type="button" class="sort-dropdown-toggle" onclick="toggleSortDropdown(event)">
                <span class="icon-text-wrap">
                    <span class="iconify" data-icon="lucide:arrow-up-down" style="color: var(--muted); font-size: 1rem;"></span>
                    <span id="sortDropdownText">@sortText</span>
                </span>
                <span class="iconify chevron" data-icon="lucide:chevron-down"></span>
            </button>

            <div class="sort-dropdown-menu" id="sortDropdownMenu">
                <div class="sort-dropdown-item @(currentSort == "recent" ? "selected" : "")" onclick="selectSortOption(event, 'recent', 'Recently Saved')">
                    Recently Saved
                    <span class="iconify check-icon" data-icon="lucide:check"></span>
                </div>
                <div class="sort-dropdown-item @(currentSort == "oldest" ? "selected" : "")" onclick="selectSortOption(event, 'oldest', 'Oldest First')">
                    Oldest First
                    <span class="iconify check-icon" data-icon="lucide:check"></span>
                </div>
                <div class="sort-dropdown-item @(currentSort == "title" ? "selected" : "")" onclick="selectSortOption(event, 'title', 'Title (A–Z)')">
                    Title (A–Z)
                    <span class="iconify check-icon" data-icon="lucide:check"></span>
                </div>
            </div>
        </div>
    </div>
</form>

@* ── Job Cards ────────────────────────────────────────────── *@
@if (Model.Any())
{
    foreach (var job in Model)
    {
        var initials = job.CompanyName.Length > 0
            ? job.CompanyName.Substring(0, Math.Min(2, job.CompanyName.Length)).ToUpper()
            : "?";

        var jobTypeLabel = job.JobType switch
        {
            "FullTime" => "Full-time",
            "PartTime" => "Part-time",
            "Internship" => "Internship",
            _ => job.JobType
        };

        <div class="sj-card @(!job.IsActive ? "sj-card--closed" : "")">

            @* ── Card body (clickable) ──────────────────────── *@
            <a asp-controller="Jobs" asp-action="Details" asp-route-id="@job.JobId" class="sj-card-link">

                @* Company logo *@
                <div class="sj-card-logo">
                    @if (!string.IsNullOrEmpty(job.CompanyLogo))
                    {
                        <img src="@job.CompanyLogo" alt="@job.CompanyName" />
                    }
                    else
                    {
                        @initials
                    }
                </div>

                @* Main content *@
                <div class="sj-card-body">
                    <div class="sj-card-title-row">
                        <span class="sj-card-title">@job.JobTitle</span>
                        @if (!job.IsActive)
                        {
                            <span class="status-badge badge-rejected sj-closed-badge">Closed</span>
                        }
                    </div>

                    <div class="sj-card-company">
                        <span class="iconify" data-icon="lucide:building-2"></span>
                        @job.CompanyName
                    </div>

                    <div class="sj-card-meta">
                        <span>
                            <span class="iconify" data-icon="lucide:map-pin"></span>
                            @job.Location
                        </span>
                        <span>
                            <span class="iconify" data-icon="lucide:clock"></span>
                            @job.PostedDateDisplay
                        </span>
                        @if (!string.IsNullOrEmpty(job.SalaryDisplay))
                        {
                            <span>
                                <span class="iconify" data-icon="lucide:dollar-sign"></span>
                                @job.SalaryDisplay
                            </span>
                        }
                    </div>

                    <p class="sj-card-desc">@job.DescriptionSnippet</p>

                    <div class="sj-card-tags">
                        <span class="job-type-tag">@jobTypeLabel</span>
                    </div>
                </div>

            </a>

            @* ── Remove (toggle) button ─────────────────────── *@
            <div class="sj-card-actions">
                <form asp-controller="Candidate" asp-action="ToggleSaveJob"
                      method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="jobId"
                           value="@job.JobId" />
                    <input type="hidden" name="returnUrl"
                           value="@Url.Action("SavedJobs", "Candidate", new { search = currentSearch, sortBy = currentSort })" />
                    <button type="submit" class="sj-remove-btn" title="Remove from saved">
                        <span class="iconify" data-icon="lucide:bookmark-x"></span>
                        Remove
                    </button>
                </form>
            </div>

        </div>
    }
}
else
{
    @* ── Empty state ─────────────────────────────────────── *@
    <div class="app-card sj-empty">
        <span class="iconify sj-empty-icon" data-icon="lucide:bookmark-x"></span>
        @if (!string.IsNullOrWhiteSpace(currentSearch))
        {
            <p class="sj-empty-title">No results for "@currentSearch"</p>
            <p class="sj-empty-sub">Try a different search term.</p>
            <a asp-controller="Candidate" asp-action="SavedJobs"
               class="btn-outline-app mt-3">
                Clear search
            </a>
        }
        else
        {
            <p class="sj-empty-title">No saved jobs yet</p>
            <p class="sj-empty-sub">Browse jobs and bookmark the ones you like.</p>
            <a asp-controller="Jobs" asp-action="Index" class="btn-primary-app mt-3">
                <span class="iconify" data-icon="lucide:search"></span>
                Browse Jobs
            </a>
        }
    </div>
}

@* Hidden form to execute "Clear All" action without nesting forms *@
<form asp-controller="Candidate" asp-action="ClearSavedJobs" method="post" id="clearAllForm" style="display:none;">
    @Html.AntiForgeryToken()
</form>

@* ── Confirmation modal for Clear All ────────────────────── *@
<div class="modal fade" id="clearAllModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border:1px solid var(--border);border-radius:var(--radius-lg);">
            <div class="modal-header" style="border-color:var(--border);padding:1rem 1.25rem;">
                <h5 class="modal-title"
                    style="font-family:'Sora',sans-serif;font-size:1rem;font-weight:700;color:var(--dark);">
                    Clear all saved jobs?
                </h5>
                <button type="button" class="btn-close"
                        data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" style="padding:1rem 1.25rem;">
                <p style="margin:0;font-size:.95rem;color:var(--dark);">
                    This will remove all <strong>@Model.Count</strong>
                    saved job@(Model.Count != 1 ? "s" : "") from your list.
                </p>
                <p style="margin-top:.5rem;font-size:.875rem;color:var(--muted);">
                    This action cannot be undone.
                </p>
            </div>
            <div class="modal-footer" style="border-color:var(--border);padding:1rem 1.25rem;gap:.75rem;">
                <button type="button" class="btn-outline-app"
                        data-bs-dismiss="modal">
                    Cancel
                </button>
                <button type="button" class="btn-reject"
                        onclick="document.getElementById('clearAllForm').submit()">
                    <span class="iconify" data-icon="lucide:trash-2"></span>
                    Yes, Clear All
                </button>
            </div>
        </div>
    </div>
</div>

<div id="toastContainer"></div>

@section Scripts {
    <script>
        // Custom Dropdown Interactions
        function toggleSortDropdown(event) {
            event.stopPropagation();
            document.getElementById('sortDropdownMenu').classList.toggle('show');
        }

        function selectSortOption(event, value, text) {
            event.stopPropagation();

            // Update the hidden input & button text
            document.getElementById('sortByInput').value = value;
            document.getElementById('sortDropdownText').innerText = text;

            // Move the 'selected' highlight
            document.querySelectorAll('.sort-dropdown-item').forEach(el => el.classList.remove('selected'));
            event.currentTarget.classList.add('selected');

            // Close menu and auto-submit
            document.getElementById('sortDropdownMenu').classList.remove('show');
            document.getElementById('filterForm').submit();
        }

        // Close dropdown when clicking outside
        window.addEventListener('click', function (event) {
            if (!event.target.closest('#sortDropdownWrap')) {
                const sortMenu = document.getElementById('sortDropdownMenu');
                if (sortMenu && sortMenu.classList.contains('show')) sortMenu.classList.remove('show');
            }
        });

        function showToast(message, isError = false) {
            var container = document.getElementById('toastContainer');
            if (!container) return;
            var toast = document.createElement('div');
            toast.className = 'masar-toast ' + (isError ? 'masar-toast-error' : 'masar-toast-success');
            toast.innerHTML = `<span class="iconify" data-icon="${isError ? 'lucide:circle-x' : 'lucide:check-circle'}" style="font-size:1.5rem"></span> <div>${message}</div>`;
            container.appendChild(toast);

            if (typeof Iconify !== 'undefined') {
                Iconify.scan(toast);
            }

            setTimeout(() => toast.classList.add('show'), 10);
            setTimeout(() => {
                toast.classList.remove('show');
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        function confirmClearAll() {
            var modal = new bootstrap.Modal(document.getElementById('clearAllModal'));
            modal.show();
        }

        document.addEventListener('DOMContentLoaded', function() {
            // Check if TempData has the success message upon redirect and trigger the toast
        @if (TempData["SavedJobsSuccess"] != null)
        {
            <text>
                        showToast("@TempData["SavedJobsSuccess"]", false);
            </text>
        }
        });
    </script>
}