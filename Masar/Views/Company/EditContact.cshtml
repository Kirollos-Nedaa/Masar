@model Masar.Domain.ViewModels.CompanyDtos.EditCompanyContactDto

@{
    ViewData["Title"] = "Edit Contact Info";
    ViewData["HasSidebar"] = true;
}

@section Sidebar {
    <partial name="_CompanySidebar" />
}

<div class="page-header d-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="page-title">Edit Contact Information</h1>
        <p class="page-subtitle">How candidates can reach you</p>
    </div>
    <a asp-action="Profile" class="btn-outline-app">
        <span class="iconify" data-icon="lucide:arrow-left"></span> Back
    </a>
</div>

<div class="app-card">
    <div class="card-body p-4">
        <form asp-action="EditContact" method="post" id="companyContactForm">

            <div class="row mb-4">
                <div class="col-md-6">
                    <label asp-for="ContactEmail" class="form-label fw-medium"></label>
                    <input asp-for="ContactEmail" class="form-control" type="email" />
                    <span asp-validation-for="ContactEmail" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="ContactPhone" class="form-label fw-medium"></label>
                    <input asp-for="ContactPhone" class="form-control" type="tel" />
                    <span asp-validation-for="ContactPhone" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-4">
                <label asp-for="Address" class="form-label fw-medium"></label>
                <input asp-for="Address" class="form-control" placeholder="e.g. 123 Tech Avenue, Cairo" />
                <span asp-validation-for="Address" class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-end gap-3 mt-4">
                <a asp-action="Profile" class="btn btn-light px-4">Cancel</a>
                <button type="submit" class="btn-primary-app px-4">Save Changes</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}