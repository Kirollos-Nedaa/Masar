@model Masar.Domain.ViewModels.CompanyDtos.CompanyInfoDto
@using Masar.Domain.Enums
@using Masar.Domain.Helpers

@{
    ViewData["Title"] = "Edit Company Info";
    ViewData["HasSidebar"] = true;
}

@* ── Style to force dropdowns downward securely ── *@
<style>
    .custom-dropdown {
        position: relative !important;
    }

    .custom-dropdown-menu {
        position: absolute !important;
        top: calc(100% + 4px) !important;
        left: 0 !important;
        right: auto !important;
        width: 100% !important;
        z-index: 1050 !important;
        overflow-y: auto;
    }
</style>

@section Sidebar {
    <partial name="_CompanySidebar" />
}

@* ── Page Header ──────────────────────────────────────────── *@
<div class="page-header d-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="page-title">Edit Company Information</h1>
        <p class="page-subtitle">Update your company details</p>
    </div>
    <a asp-controller="Company" asp-action="Profile" class="btn-outline-app">
        <span class="iconify" data-icon="lucide:arrow-left"></span> Back to Profile
    </a>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="epi-alert-error mb-4">
        <span class="iconify" data-icon="lucide:circle-alert"></span>
        @Html.ValidationSummary(false)
    </div>
}

<form asp-controller="Company" asp-action="EditInfo" method="post" id="companyInfoForm">
    @Html.AntiForgeryToken()

    @* ── Basic Information ────────────────────────────────── *@
    <div class="app-card mb-4">
        <div class="card-section-header mb-4">
            <div class="card-section-title">
                <span class="iconify me-2" data-icon="lucide:building-2"></span>
                Basic Information
            </div>
        </div>

        @* Logo URL *@
        <div class="row g-3 mb-3">
            <div class="col-12">
                <label class="epi-label">Logo URL</label>
                <input asp-for="LogoUrl" class="epi-input" placeholder="https://example.com/logo.png" />
                <span asp-validation-for="LogoUrl" class="epi-error"></span>
            </div>
        </div>

        @* Company Name *@
        <div class="row g-3 mb-3">
            <div class="col-12">
                <label class="epi-label">Company Name</label>
                <input asp-for="CompanyName" class="epi-input" placeholder="e.g. Acme Corporation" />
                <span asp-validation-for="CompanyName" class="epi-error"></span>
            </div>
        </div>

        @* Industry + Size Dropdowns *@
        <div class="row g-3 mb-3">

            @* ── Industry Custom Dropdown ── *@
            <div class="col-12 col-sm-6">
                <label class="epi-label">Industry</label>
                @{
                    var currentIndName = Model.Industry != Industries.None ? IndustryMetadata.GetDisplayName(Model.Industry) : "Select industry";
                    var currentIndIcon = Model.Industry != Industries.None ? IndustryMetadata.GetIcon(Model.Industry) : "lucide:briefcase";
                }
                <div class="custom-dropdown position-relative w-100" id="industryDropdownWrap">
                    <input asp-for="Industry" type="hidden" />
                    <button type="button" class="custom-dropdown-toggle epi-input d-flex align-items-center justify-content-between w-100 text-start" onclick="toggleCustomSelect(event, 'industryMenu')">
                        <span class="icon-text-wrap">
                            <span class="iconify display-icon text-muted" data-icon="@currentIndIcon"></span>
                            <span class="display-text">@currentIndName</span>
                        </span>
                        <span class="iconify chevron text-muted" data-icon="lucide:chevron-down"></span>
                    </button>
                    <div class="custom-dropdown-menu w-100" id="industryMenu">
                        <div class="dropdown-scroll-area">
                            @foreach (var ind in IndustryMetadata.All())
                            {
                                var name = IndustryMetadata.GetDisplayName(ind);
                                var icon = IndustryMetadata.GetIcon(ind);

                                <div class="custom-dropdown-item @(Model.Industry == ind ? "selected" : "")"
                                     onclick="selectDropdownOption(event, 'industryDropdownWrap', '@((int)ind)', '@name', '@icon')">
                                    <span class="iconify ind-icon" data-icon="@icon"></span>
                                    <span class="ind-name">@name</span>
                                    <span class="iconify check-icon" data-icon="lucide:check"></span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <span asp-validation-for="Industry" class="epi-error"></span>
            </div>

            @* ── Company Size Custom Dropdown ── *@
            <div class="col-12 col-sm-6">
                <label class="epi-label">Company Size</label>
                @{
                    var currentSize = Model.Size ?? CompanySize.None;
                    var currentSizeName = currentSize != CompanySize.None ? CompanySizeMetadata.GetDisplayName(currentSize) : "Select size";
                    var currentSizeIcon = currentSize != CompanySize.None ? CompanySizeMetadata.GetIcon(currentSize) : "lucide:users";
                }
                <div class="custom-dropdown position-relative w-100" id="sizeWrap">
                    <input asp-for="Size" type="hidden" />
                    <button type="button" class="custom-dropdown-toggle epi-input d-flex align-items-center justify-content-between w-100 text-start" onclick="toggleCustomSelect(event, 'sizeMenu')">
                        <span class="icon-text-wrap">
                            <span class="iconify display-icon text-muted" data-icon="@currentSizeIcon"></span>
                            <span class="display-text">@currentSizeName</span>
                        </span>
                        <span class="iconify chevron text-muted" data-icon="lucide:chevron-down"></span>
                    </button>
                    <div class="custom-dropdown-menu w-100" id="sizeMenu">
                        <div class="dropdown-scroll-area">
                            @foreach (var size in Enum.GetValues<CompanySize>().Where(s => s != CompanySize.None))
                            {
                                var name = CompanySizeMetadata.GetDisplayName(size);
                                var icon = CompanySizeMetadata.GetIcon(size);

                                <div class="custom-dropdown-item @(Model.Size == size ? "selected" : "")"
                                     onclick="selectDropdownOption(event, 'sizeWrap', '@((int)size)', '@name', '@icon')">
                                    <span class="iconify ind-icon" data-icon="@icon"></span>
                                    <span class="ind-name">@name</span>
                                    <span class="iconify check-icon" data-icon="lucide:check"></span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <span asp-validation-for="Size" class="epi-error"></span>
            </div>

        </div>

        @* Description *@
        <div class="row g-3">
            <div class="col-12">
                <label class="epi-label">
                    Description
                    <span class="epi-char-count" id="descCount">0 / 2000</span>
                </label>
                <textarea asp-for="Description"
                          rows="5"
                          class="epi-input epi-textarea"
                          placeholder="Tell candidates about your company..."
                          maxlength="2000"
                          oninput="updateDescCount(this)"></textarea>
                <span asp-validation-for="Description" class="epi-error"></span>
            </div>
        </div>
    </div>

    @* ── Contact Information ──────────────────────────────── *@
    <div class="app-card mb-4">
        <div class="card-section-header mb-4">
            <div class="card-section-title">
                <span class="iconify me-2" data-icon="lucide:phone"></span>
                Contact Information
            </div>
        </div>

        <div class="row g-3 mb-3">
            <div class="col-12 col-sm-6">
                <label class="epi-label">Contact Email</label>
                <input asp-for="ContactEmail" type="email" class="epi-input" placeholder="contact@company.com" />
                <span asp-validation-for="ContactEmail" class="epi-error"></span>
            </div>
            <div class="col-12 col-sm-6">
                <label class="epi-label">Contact Phone <span style="color:var(--red)">*</span></label>
                <input type="hidden" asp-for="ContactPhone" id="CompanyContactPhone" />
                <div class="phone-input-wrap" id="companyPhoneWrap">
                    <div class="phone-country-btn" id="companyCountryBtn">
                        <span id="companySelectedFlag">
                            <span class="iconify" data-icon="circle-flags:eg" style="font-size:1.25rem;"></span>
                        </span>
                        <span id="companySelectedCode">+20</span>
                        <span class="iconify phone-chevron" data-icon="lucide:chevron-down"></span>
                    </div>
                    <div class="phone-country-dropdown" id="companyCountryDropdown" style="display:none;">
                        <div class="phone-search-wrap">
                            <span class="iconify phone-search-icon" data-icon="lucide:search"></span>
                            <input type="text" id="companyCountrySearch" class="phone-search-input" placeholder="Search country..." onclick="event.stopPropagation()" />
                        </div>
                        <ul id="companyCountryList" class="phone-country-list"></ul>
                    </div>
                    <input type="text" id="companyPhoneLocal" class="epi-input phone-local-input" placeholder="010XXXXXXXX" inputmode="numeric" />
                </div>
                <span class="epi-hint">Include at least 11 digits. Leading zero is removed automatically.</span>
                <span asp-validation-for="ContactPhone" class="epi-error"></span>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-12">
                <label class="epi-label">Address</label>
                <input asp-for="Address" class="epi-input" placeholder="123 Main St, Cairo, Egypt" />
                <span asp-validation-for="Address" class="epi-error"></span>
            </div>
        </div>
    </div>

    @* ── Actions ──────────────────────────────────────────── *@
    <div class="d-flex justify-content-end gap-2">
        <a asp-controller="Company" asp-action="Profile" class="btn-outline-app">
            Cancel
        </a>
        <button type="submit" class="btn-primary-app">
            <span class="iconify" data-icon="lucide:save"></span> Save Changes
        </button>
    </div>

</form>

@section Scripts {
    <script>
        // ── Universal Custom Single-Select Logic ─────────────────
        function toggleCustomSelect(event, menuId) {
            event.preventDefault();
            event.stopPropagation();

            document.querySelectorAll('.custom-dropdown-menu.show').forEach(m => {
                if (m.id !== menuId) m.classList.remove('show');
            });

            document.getElementById(menuId).classList.toggle('show');
        }

        function selectDropdownOption(event, wrapId, value, text, icon) {
            event.stopPropagation();
            const wrap = document.getElementById(wrapId);

            const hiddenInput = wrap.querySelector('input[type="hidden"]');
            hiddenInput.value = value;
            hiddenInput.dispatchEvent(new Event('change'));

            wrap.querySelector('.display-text').innerText = text;
            const iconEl = wrap.querySelector('.display-icon');
            if (iconEl && icon) {
                iconEl.setAttribute('data-icon', icon);
            }

            wrap.querySelectorAll('.custom-dropdown-item').forEach(el => el.classList.remove('selected'));
            event.currentTarget.classList.add('selected');

            wrap.querySelector('.custom-dropdown-menu').classList.remove('show');
            if (typeof Iconify !== 'undefined') {
                Iconify.scan(wrap);
            }
        }

        window.addEventListener('click', function(e) {
            if (!e.target.closest('.custom-dropdown')) {
                document.querySelectorAll('.custom-dropdown-menu.show').forEach(m => m.classList.remove('show'));
            }
        });

        // ── Description Counter ───────────────────────────────────
        function updateDescCount(textarea) {
            document.getElementById('descCount').textContent = `${textarea.value.length} / 2000`;
        }

        window.addEventListener('DOMContentLoaded', () => {
            const desc = document.querySelector('textarea[name="Description"]');
            if (desc) updateDescCount(desc);

            MasarPhoneInput.init({
                formId: 'companyInfoForm',
                hiddenInputId: 'CompanyContactPhone',
                localInputId: 'companyPhoneLocal',
                wrapperId: 'companyPhoneWrap',
                countryButtonId: 'companyCountryBtn',
                dropdownId: 'companyCountryDropdown',
                countryListId: 'companyCountryList',
                countrySearchId: 'companyCountrySearch',
                selectedFlagId: 'companySelectedFlag',
                selectedCodeId: 'companySelectedCode',
                defaultCountryIso: 'eg',
                minDigits: 11,
                requiredMessage: 'Contact phone is required.',
                minDigitsMessage: 'Contact phone must contain at least 11 digits.'
            });
        });
    </script>
    <partial name="_ValidationScriptsPartial" />
}