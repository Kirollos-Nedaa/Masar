@model Masar.Domain.ViewModels.CompanyDtos.EditCompanyInfoDto
@using Masar.Domain.Helpers

@{
    ViewData["Title"] = "Edit General Info";
    ViewData["HasSidebar"] = true;
}

@section Sidebar {
    <partial name="_CompanySidebar" />
}

<div class="page-header d-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="page-title">Edit General Information</h1>
        <p class="page-subtitle">Update your core company details</p>
    </div>
    <a asp-action="Profile" class="btn-outline-app">
        <span class="iconify" data-icon="lucide:arrow-left"></span> Back
    </a>
</div>

<div class="app-card">
    <div class="card-body p-4">
        <form asp-action="EditInfo" method="post">
            <div class="mb-4">
                <label asp-for="CompanyName" class="form-label fw-medium"></label>
                <input asp-for="CompanyName" class="form-control" />
                <span asp-validation-for="CompanyName" class="text-danger small"></span>
            </div>

            <div class="row mb-4">
                <div class="col-md-6">
                    <label asp-for="Industry" class="form-label fw-medium"></label>
                    <select asp-for="Industry" class="form-select">
                        <option value="">Select Industry...</option>
                        @foreach (var ind in IndustryMetadata.All())
                        {
                            <option value="@ind">@IndustryMetadata.GetDisplayName(ind)</option>
                        }
                    </select>
                    <span asp-validation-for="Industry" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Size" class="form-label fw-medium"></label>
                    <select asp-for="Size" asp-items="Html.GetEnumSelectList<Masar.Domain.Enums.CompanySize>()" class="form-select">
                        <option value="">Select Company Size...</option>
                    </select>
                    <span asp-validation-for="Size" class="text-danger small"></span>
                </div>
            </div>

            <div class="mb-4">
                <label asp-for="Description" class="form-label fw-medium"></label>
                <textarea asp-for="Description" class="form-control" rows="5"></textarea>
                <span asp-validation-for="Description" class="text-danger small"></span>
            </div>

            <div class="d-flex justify-content-end gap-3 mt-4">
                <a asp-action="Profile" class="btn btn-light px-4">Cancel</a>
                <button type="submit" class="btn-primary-app px-4">Save Changes</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}