@using Masar.Domain.ViewModels.CompanyDtos
@using Masar.Domain.Enums
@using Masar.Domain.ViewModels.Job
@using Masar.Domain.Helpers
@model PostJobDto

@{
    bool isEdit = ViewData["IsEdit"] is true;
    ViewData["Title"] = isEdit ? "Edit Job" : "Post a New Job";
    ViewData["HasSidebar"] = true;
}

@* ── Style to force dropdowns downward securely ── *@
<style>
    .custom-dropdown {
        position: relative !important;
    }

    .custom-dropdown-menu {
        position: absolute !important;
        top: calc(100% + 4px) !important;
        left: 0 !important;
        right: auto !important;
        width: 100% !important;
        z-index: 1050 !important;
        overflow-y: auto;
    }
</style>

@section Sidebar {
    <partial name="_CompanySidebar" />
}

<div class="page-header d-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="page-title">@(isEdit ? "Edit Job Posting" : "Post a New Job")</h1>
        <p class="page-subtitle">@(isEdit ? "Update the details below" : "Fill out the details below to create a new job posting")</p>
    </div>
    <a asp-controller="Company" asp-action="Jobs" class="btn-outline-app">
        <span class="iconify" data-icon="lucide:arrow-left"></span> Back to Jobs
    </a>
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="epi-alert-error mb-4">
        <span class="iconify" data-icon="lucide:circle-alert"></span>
        @Html.ValidationSummary(false, null, new { @class = "mb-0" })
    </div>
}

<form asp-controller="Company" asp-action="@(isEdit ? "EditJob" : "PostJob")" method="post" id="postJobForm">
    @Html.AntiForgeryToken()
    @if (isEdit)
    {
        <input type="hidden" name="jobId" value="@ViewData["JobId"]" />
    }

    @* ── Section 1: Basic Information ────────────────────── *@
    <div class="app-card mb-4">
        <div class="card-section-header mb-4">
            <div class="card-section-title">
                <span class="iconify me-2" data-icon="lucide:briefcase" style="font-size:1.1rem;"></span>
                Basic Information
            </div>
        </div>

        <div class="mb-3">
            <label class="epi-label">Job Title <span style="color:var(--red)">*</span></label>
            <input asp-for="Title" class="epi-input" placeholder="e.g. Frontend Developer Intern" />
            <span asp-validation-for="Title" class="epi-error"></span>
        </div>

        <div class="row g-3 mb-3">
            @* ── Job Type Dropdown ── *@
            <div class="col-12 col-sm-6">
                <label class="epi-label">Job Type <span style="color:var(--red)">*</span></label>
                @{
                    var currentJtName = Model.JobType != JobType.None ? JobTypeMetadata.GetDisplayName(Model.JobType) : "Select job type";
                    var currentJtIcon = Model.JobType != JobType.None ? JobTypeMetadata.GetIcon(Model.JobType) : "lucide:briefcase";
                }
                <div class="custom-dropdown position-relative w-100" id="jobTypeWrap">
                    <input asp-for="JobType" type="hidden" />
                    <button type="button" class="custom-dropdown-toggle epi-input d-flex align-items-center justify-content-between w-100 text-start" onclick="toggleCustomSelect(event, 'jobTypeMenu')">
                        <span class="icon-text-wrap">
                            <span class="iconify display-icon text-muted" data-icon="@currentJtIcon"></span>
                            <span class="display-text">@currentJtName</span>
                        </span>
                        <span class="iconify chevron text-muted" data-icon="lucide:chevron-down"></span>
                    </button>
                    <div class="custom-dropdown-menu w-100" id="jobTypeMenu">
                        <div class="dropdown-scroll-area">
                            @foreach (var jt in JobTypeMetadata.All())
                            {
                                var name = JobTypeMetadata.GetDisplayName(jt);
                                var icon = JobTypeMetadata.GetIcon(jt);

                                <div class="custom-dropdown-item @(Model.JobType == jt ? "selected" : "")"
                                     onclick="selectDropdownOption(event, 'jobTypeWrap', '@((int)jt)', '@name', '@icon')">
                                    <span class="iconify ind-icon" data-icon="@icon"></span>
                                    <span class="ind-name">@name</span>
                                    <span class="iconify check-icon" data-icon="lucide:check"></span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <span asp-validation-for="JobType" class="epi-error"></span>
            </div>

            @* ── Department Dropdown ── *@
            <div class="col-12 col-sm-6">
                <label class="epi-label">Department <span style="color:var(--red)">*</span></label>
                @{
                    var currentDeptName = Model.Department != Department.None ? DepartmentMetadata.GetDisplayName(Model.Department) : "Select department";
                    var currentDeptIcon = Model.Department != Department.None ? DepartmentMetadata.GetIcon(Model.Department) : "lucide:users";
                }
                <div class="custom-dropdown position-relative w-100" id="deptWrap">
                    <input asp-for="Department" type="hidden" />
                    <button type="button" class="custom-dropdown-toggle epi-input d-flex align-items-center justify-content-between w-100 text-start" onclick="toggleCustomSelect(event, 'deptMenu')">
                        <span class="icon-text-wrap">
                            <span class="iconify display-icon text-muted" data-icon="@currentDeptIcon"></span>
                            <span class="display-text">@currentDeptName</span>
                        </span>
                        <span class="iconify chevron text-muted" data-icon="lucide:chevron-down"></span>
                    </button>
                    <div class="custom-dropdown-menu w-100" id="deptMenu">
                        <div class="dropdown-scroll-area">
                            @foreach (var dept in DepartmentMetadata.All())
                            {
                                var name = DepartmentMetadata.GetDisplayName(dept);
                                var icon = DepartmentMetadata.GetIcon(dept);

                                <div class="custom-dropdown-item @(Model.Department == dept ? "selected" : "")"
                                     onclick="selectDropdownOption(event, 'deptWrap', '@((int)dept)', '@name', '@icon')">
                                    <span class="iconify ind-icon" data-icon="@icon"></span>
                                    <span class="ind-name">@name</span>
                                    <span class="iconify check-icon" data-icon="lucide:check"></span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <span asp-validation-for="Department" class="epi-error"></span>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-12 col-sm-6">
                <label class="epi-label">Location <span style="color:var(--red)">*</span></label>
                <div class="position-relative">
                    <input type="text" id="locationDisplay" class="epi-input"
                           placeholder="e.g. Cairo, EG" autocomplete="off"
                           oninput="onLocationInput(this.value)" value="@Model.Location" />
                    <input asp-for="Location" type="hidden" id="Location" />
                    <ul id="locationSuggestions" class="location-suggestions" style="display:none;"></ul>
                </div>
                <span asp-validation-for="Location" class="epi-error"></span>
            </div>

            @* ── Work Mode Dropdown ── *@
            <div class="col-12 col-sm-6">
                <label class="epi-label">Work Mode <span style="color:var(--red)">*</span></label>
                @{
                    var currentWmName = Model.WorkMode != WorkMode.None ? WorkModeMetadata.GetDisplayName(Model.WorkMode) : "Select mode";
                    var currentWmIcon = Model.WorkMode != WorkMode.None ? WorkModeMetadata.GetIcon(Model.WorkMode) : "lucide:map-pin";
                }
                <div class="custom-dropdown position-relative w-100" id="workModeWrap">
                    <input asp-for="WorkMode" type="hidden" />
                    <button type="button" class="custom-dropdown-toggle epi-input d-flex align-items-center justify-content-between w-100 text-start" onclick="toggleCustomSelect(event, 'workModeMenu')">
                        <span class="icon-text-wrap">
                            <span class="iconify display-icon text-muted" data-icon="@currentWmIcon"></span>
                            <span class="display-text">@currentWmName</span>
                        </span>
                        <span class="iconify chevron text-muted" data-icon="lucide:chevron-down"></span>
                    </button>
                    <div class="custom-dropdown-menu w-100" id="workModeMenu">
                        <div class="dropdown-scroll-area">
                            @foreach (var wm in WorkModeMetadata.All())
                            {
                                var name = WorkModeMetadata.GetDisplayName(wm);
                                var icon = WorkModeMetadata.GetIcon(wm);

                                <div class="custom-dropdown-item @(Model.WorkMode == wm ? "selected" : "")"
                                     onclick="selectDropdownOption(event, 'workModeWrap', '@((int)wm)', '@name', '@icon')">
                                    <span class="iconify ind-icon" data-icon="@icon"></span>
                                    <span class="ind-name">@name</span>
                                    <span class="iconify check-icon" data-icon="lucide:check"></span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <span asp-validation-for="WorkMode" class="epi-error"></span>
            </div>
        </div>
    </div>

    @* ── Section 2: Compensation ──────────────────────────── *@
    <div class="app-card mb-4">
        <div class="card-section-header mb-4">
            <div class="card-section-title">
                <span class="iconify me-2" data-icon="lucide:banknote" style="font-size:1.1rem;"></span>
                Compensation
            </div>
            <span class="job-optional-label">Optional</span>
        </div>
        <div class="row g-3">
            <div class="col-12 col-sm-6">
                <label class="epi-label">Minimum Salary</label>
                <div class="salary-input-wrap">
                    <span class="salary-prefix">$</span>
                    <input asp-for="MinSalary" type="number" class="epi-input salary-input" placeholder="50000" min="0" />
                </div>
                <span asp-validation-for="MinSalary" class="epi-error"></span>
            </div>
            <div class="col-12 col-sm-6">
                <label class="epi-label">Maximum Salary</label>
                <div class="salary-input-wrap">
                    <span class="salary-prefix">$</span>
                    <input asp-for="MaxSalary" type="number" class="epi-input salary-input" placeholder="80000" min="0" />
                </div>
                <span asp-validation-for="MaxSalary" class="epi-error"></span>
            </div>
        </div>
    </div>

    @* ── Section 3: Job Description ───────────────────────── *@
    <div class="app-card mb-4">
        <div class="card-section-header mb-4">
            <div class="card-section-title">
                <span class="iconify me-2" data-icon="lucide:file-text" style="font-size:1.1rem;"></span>
                Job Description
            </div>
        </div>
        <div class="mb-3">
            <label class="epi-label">
                Description <span style="color:var(--red)">*</span>
                <span class="epi-char-count" id="descCount">0 / 4000</span>
            </label>
            <textarea asp-for="Description" rows="5" class="epi-input epi-textarea"
                      placeholder="Describe the role, responsibilities, and what the candidate will be working on..."
                      maxlength="4000" oninput="updateCount(this, 'descCount')"></textarea>
            <span asp-validation-for="Description" class="epi-error"></span>
        </div>
        <div class="mb-3">
            <label class="epi-label">
                Requirements <span style="color:var(--red)">*</span>
                <span class="epi-char-count" id="reqCount">0 / 4000</span>
            </label>
            <textarea asp-for="Requirements" rows="5" class="epi-input epi-textarea"
                      placeholder="List the required skills, qualifications, and experience..."
                      maxlength="4000" oninput="updateCount(this, 'reqCount')"></textarea>
            <span asp-validation-for="Requirements" class="epi-error"></span>
        </div>
        <div>
            <label class="epi-label">
                Benefits & Perks
                <span class="job-optional-label ms-1">Optional</span>
                <span class="epi-char-count" id="benCount">0 / 4000</span>
            </label>
            <textarea asp-for="Benefits" rows="3" class="epi-input epi-textarea"
                      placeholder="What benefits and perks do you offer?"
                      maxlength="4000" oninput="updateCount(this, 'benCount')"></textarea>
            <span asp-validation-for="Benefits" class="epi-error"></span>
        </div>
    </div>

    @* ── Section 4: Application Details ──────────────────── *@
    <div class="app-card mb-4">
        <div class="card-section-header mb-4">
            <div class="card-section-title">
                <span class="iconify me-2" data-icon="lucide:calendar-check" style="font-size:1.1rem;"></span>
                Application Details
            </div>
        </div>
        <div class="row g-3 mb-3">
            <div class="col-12 col-sm-6">
                <label class="epi-label">Application Deadline <span style="color:var(--red)">*</span></label>
                <div class="date-input-wrap">
                    <input asp-for="ApplicationDeadline" type="datetime-local" class="epi-input" id="ApplicationDeadline" />
                </div>
                <span asp-validation-for="ApplicationDeadline" class="epi-error"></span>
            </div>
            <div class="col-12 col-sm-6">
                <label class="epi-label">Number of Positions <span style="color:var(--red)">*</span></label>
                <input asp-for="NumberOfOpenings" type="number" class="epi-input" min="1" max="1000" placeholder="1" />
                <span asp-validation-for="NumberOfOpenings" class="epi-error"></span>
            </div>
        </div>
        <div>
            <label class="epi-label mb-3">Application Requirements</label>
            <div class="d-flex flex-column gap-2">
                <label class="job-checkbox-label">
                    <input asp-for="RequireCv" type="checkbox" class="job-checkbox" />
                    <span class="job-checkbox-box"></span> Require resume/CV
                </label>
                <label class="job-checkbox-label">
                    <input asp-for="RequireCoverLetter" type="checkbox" class="job-checkbox" />
                    <span class="job-checkbox-box"></span> Require cover letter
                </label>
            </div>
        </div>
    </div>

    @* ── Section 5: Application Questions ────────────────── *@
    <div class="app-card mb-4">
        <div class="card-section-header mb-1">
            <div class="card-section-title">
                <span class="iconify me-2" data-icon="lucide:message-square-plus" style="font-size:1.1rem;"></span>
                Application Questions
            </div>
            <span class="job-optional-label">Optional</span>
        </div>
        <p class="text-muted mb-4" style="font-size:.85rem;">
            Add custom questions that candidates must answer when applying.
        </p>

        <div id="questionsContainer">
            @for (int i = 0; i < Model.Questions.Count; i++)
            {
                var q = Model.Questions[i];
                <div class="question-row" data-index="@i">
                    <input type="hidden" name="Questions[@i].Id" value="@q.Id" />
                    <div class="row g-2 align-items-start">
                        <div class="col-12 col-sm-6">
                            <input type="text" name="Questions[@i].QuestionText" class="epi-input" placeholder="e.g. When are you available to start?" value="@q.QuestionText" />
                        </div>

                        @* ── Question Type Dropdown ── *@
                        <div class="col-12 col-sm-3">
                            @{
                                var qTypeName = q.Type == "Essay" ? "Text answer" : "Yes / No";
                            }
                            <div class="custom-dropdown position-relative w-100" id="qTypeWrap_@i">
                                <input type="hidden" name="Questions[@i].Type" value="@q.Type" />
                                <button type="button" class="custom-dropdown-toggle epi-input d-flex align-items-center justify-content-between w-100 text-start" onclick="toggleCustomSelect(event, 'qTypeMenu_@i')">
                                    <span class="icon-text-wrap"><span class="display-text">@qTypeName</span></span>
                                    <span class="iconify chevron text-muted" data-icon="lucide:chevron-down"></span>
                                </button>
                                <div class="custom-dropdown-menu w-100" id="qTypeMenu_@i">
                                    <div class="dropdown-scroll-area">
                                        <div class="custom-dropdown-item @(q.Type == "Essay" ? "selected" : "")"
                                             onclick="selectDropdownOption(event, 'qTypeWrap_@i', 'Essay', 'Text answer', '')">
                                            <span class="ind-name">Text answer</span>
                                            <span class="iconify check-icon" data-icon="lucide:check"></span>
                                        </div>
                                        <div class="custom-dropdown-item @(q.Type == "TorF" ? "selected" : "")"
                                             onclick="selectDropdownOption(event, 'qTypeWrap_@i', 'TorF', 'Yes / No', '')">
                                            <span class="ind-name">Yes / No</span>
                                            <span class="iconify check-icon" data-icon="lucide:check"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-2 col-sm-1 d-flex align-items-center" style="margin: 11px 0px 0px auto">
                            <button type="button" class="btn-icon-danger" onclick="removeQuestion(this)" title="Remove">
                                <span class="iconify" data-icon="lucide:x"></span>
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>

        <button type="button" class="btn-outline-app mt-3" onclick="addQuestion()">
            <span class="iconify" data-icon="lucide:plus"></span> Add Question
        </button>
    </div>

    @* ── Actions ──────────────────────────────────────────── *@
    <div class="d-flex justify-content-end gap-2 mb-5">
        <a asp-controller="Company" asp-action="Jobs" class="btn-outline-app">Cancel</a>
        <button type="submit" class="btn-primary-app">
            <span class="iconify" data-icon="@(isEdit ? "lucide:save" : "lucide:send")"></span>
            @(isEdit ? "Save Changes" : "Publish Job")
        </button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // ── Universal Custom Single-Select Logic ─────────────────
        function toggleCustomSelect(event, menuId) {
            event.preventDefault();
            event.stopPropagation();

            document.querySelectorAll('.custom-dropdown-menu.show').forEach(m => {
                if (m.id !== menuId) m.classList.remove('show');
            });

            document.getElementById(menuId).classList.toggle('show');
        }

        function selectDropdownOption(event, wrapId, value, text, icon) {
            event.stopPropagation();
            const wrap = document.getElementById(wrapId);

            const hiddenInput = wrap.querySelector('input[type="hidden"]');
            hiddenInput.value = value;
            hiddenInput.dispatchEvent(new Event('change'));

            wrap.querySelector('.display-text').innerText = text;
            const iconEl = wrap.querySelector('.display-icon');
            if (iconEl && icon) {
                iconEl.setAttribute('data-icon', icon);
            }

            wrap.querySelectorAll('.custom-dropdown-item').forEach(el => el.classList.remove('selected'));
            event.currentTarget.classList.add('selected');

            wrap.querySelector('.custom-dropdown-menu').classList.remove('show');

            if (typeof Iconify !== 'undefined') {
                Iconify.scan(wrap);
            }
        }

        window.addEventListener('click', function(e) {
            if (!e.target.closest('.custom-dropdown')) {
                document.querySelectorAll('.custom-dropdown-menu.show').forEach(m => m.classList.remove('show'));
            }
        });

        // ── Standard UI Logic ────────────────────────────────────
        function updateCount(el, id) {
            document.getElementById(id).textContent = `${el.value.length} / ${el.maxLength}`;
        }

        window.addEventListener('DOMContentLoaded', () => {
            [['Description','descCount'],['Requirements','reqCount'],['Benefits','benCount']]
                .forEach(([name, id]) => {
                    const el = document.querySelector(`textarea[name="${name}"]`);
                    if (el) updateCount(el, id);
                });
            const locDisplay = document.getElementById('locationDisplay');
            if (locDisplay?.value) document.getElementById('Location').value = locDisplay.value;
        });

        let locationDebounce;
        async function onLocationInput(value) {
            clearTimeout(locationDebounce);
            document.getElementById('Location').value = value;
            const s = document.getElementById('locationSuggestions');
            if (!value.trim() || value.length < 2) { s.style.display = 'none'; return; }

            locationDebounce = setTimeout(async () => {
                try {
                    const res = await fetch(
                        `https://nominatim.openstreetmap.org/search?q=${encodeURIComponent(value)}&format=json&limit=6&addressdetails=1`,
                        { headers: { 'Accept-Language': 'en' } });
                    if (!res.ok) return;
                    renderLocationSuggestions(await res.json());
                } catch { s.style.display = 'none'; }
            }, 350);
        }

        function renderLocationSuggestions(results) {
            const s = document.getElementById('locationSuggestions');
            if (!results.length) { s.style.display = 'none'; return; }
            s.innerHTML = results.map(r => {
                const city  = r.address?.city ?? r.address?.town ?? r.address?.village ?? r.name;
                const cc    = (r.address?.country_code ?? '').toUpperCase();
                const label = cc ? `${city}, ${cc}` : city;
                return `<li class="location-item" onclick="selectLocation('${label.replace(/'/g,"\\'")}')">
                    <span class="iconify location-item-icon" data-icon="lucide:map-pin"></span>${label}</li>`;
            }).join('');
            s.style.display = 'block';
            Iconify.scan(s);
        }

        function selectLocation(label) {
            document.getElementById('locationDisplay').value = label;
            document.getElementById('Location').value        = label;
            document.getElementById('locationSuggestions').style.display = 'none';
        }

        document.addEventListener('click', e => {
            if (!e.target.closest('.position-relative'))
                document.getElementById('locationSuggestions').style.display = 'none';
        });

        // ── Questions management ──────────────────────────────────
        function getNextIndex() {
            return document.querySelectorAll('#questionsContainer .question-row').length;
        }

        function addQuestion() {
            const i   = getNextIndex();
            const row = document.createElement('div');
            row.className = 'question-row';
            row.dataset.index = i;

            // Cleaned JS Template mimicking the HTML block above
            row.innerHTML = `
                <div class="row g-2 align-items-start">
                    <div class="col-12 col-sm-6">
                        <input type="text" name="Questions[${i}].QuestionText" class="epi-input" placeholder="e.g. When are you available to start?" />
                    </div>

                    <div class="col-6 col-sm-3">
                        <div class="custom-dropdown position-relative w-100" id="qTypeWrap_${i}">
                            <input type="hidden" name="Questions[${i}].Type" value="Essay" />
                            <button type="button" class="custom-dropdown-toggle epi-input d-flex align-items-center justify-content-between w-100 text-start" onclick="toggleCustomSelect(event, 'qTypeMenu_${i}')">
                                <span class="icon-text-wrap"><span class="display-text">Text answer</span></span>
                                <span class="iconify chevron text-muted" data-icon="lucide:chevron-down"></span>
                            </button>
                            <div class="custom-dropdown-menu w-100" id="qTypeMenu_${i}">
                                <div class="dropdown-scroll-area">
                                    <div class="custom-dropdown-item selected" onclick="selectDropdownOption(event, 'qTypeWrap_${i}', 'Essay', 'Text answer', '')">
                                        <span class="ind-name">Text answer</span>
                                        <span class="iconify check-icon" data-icon="lucide:check"></span>
                                    </div>
                                    <div class="custom-dropdown-item" onclick="selectDropdownOption(event, 'qTypeWrap_${i}', 'TorF', 'Yes / No', '')">
                                        <span class="ind-name">Yes / No</span>
                                        <span class="iconify check-icon" data-icon="lucide:check"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-2 col-sm-1 d-flex align-items-center">
                        <button type="button" class="btn-icon-danger" onclick="removeQuestion(this)" title="Remove">
                            <span class="iconify" data-icon="lucide:x"></span>
                        </button>
                    </div>
                </div>`;

            document.getElementById('questionsContainer').appendChild(row);
            if (typeof Iconify !== 'undefined') Iconify.scan(row);
            reindexQuestions();
        }

        function removeQuestion(btn) {
            btn.closest('.question-row').remove();
            reindexQuestions();
        }

        function reindexQuestions() {
            document.querySelectorAll('#questionsContainer .question-row').forEach((row, i) => {
                row.dataset.index = i;

                row.querySelectorAll('[name]').forEach(el => {
                    el.name = el.name.replace(/Questions\[\d+\]/, `Questions[${i}]`);
                });

                const wrap = row.querySelector('.custom-dropdown');
                if (wrap) {
                    wrap.id = `qTypeWrap_${i}`;
                    const toggleBtn = wrap.querySelector('.custom-dropdown-toggle');
                    if (toggleBtn) toggleBtn.setAttribute('onclick', `toggleCustomSelect(event, 'qTypeMenu_${i}')`);

                    const menu = wrap.querySelector('.custom-dropdown-menu');
                    if (menu) menu.id = `qTypeMenu_${i}`;

                    wrap.querySelectorAll('.custom-dropdown-item').forEach(item => {
                        const onclickStr = item.getAttribute('onclick');
                        if(onclickStr) item.setAttribute('onclick', onclickStr.replace(/qTypeWrap_\d+/, `qTypeWrap_${i}`));
                    });
                }
            });
        }

        document.addEventListener('DOMContentLoaded', () => {
            const input = document.getElementById('ApplicationDeadline');
            if (input) {
                const now = new Date();
                const pad = n => n.toString().padStart(2, '0');
                input.min = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}T${pad(now.getHours())}:${pad(now.getMinutes())}`;
            }
        });
    </script>
}