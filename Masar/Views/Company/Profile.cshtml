@model Masar.Domain.ViewModels.CompanyDtos.CompanyProfileDto
@using Masar.Domain.Helpers

@{
    ViewData["Title"] = "Company Profile";
    ViewData["HasSidebar"] = true;
}

@section Sidebar {
    <partial name="_CompanySidebar" />
}

@* ── Page Header ── *@
<div class="page-header d-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="page-title">Company Profile</h1>
        <p class="page-subtitle">Manage your company presence and details</p>
    </div>
</div>

@* ── Logo Management Card ── *@
<div class="app-card mb-4">
    <div class="card-section-header">
        <div class="card-section-title">
            <span class="iconify" data-icon="lucide:image"></span> Company Logo
        </div>
    </div>

    @if (string.IsNullOrEmpty(Model.LogoUrl))
    {
        <div class="upload-box text-center p-4 border rounded bg-light mt-3">
            <span class="iconify mb-2 text-muted" data-icon="lucide:upload-cloud" style="font-size: 2.5rem;"></span>
            <p class="text-muted mb-3">Upload your company logo to stand out to candidates.</p>
            <form asp-action="UploadLogo" method="post" enctype="multipart/form-data" class="d-flex justify-content-center gap-2">
                <input type="file" name="Logo" accept="image/*" class="form-control w-auto" required />
                <button type="submit" class="btn-primary-app">Upload Logo</button>
            </form>
        </div>
    }
    else
    {
        <div class="d-flex align-items-center gap-4 mt-3">
            <img src="@Model.LogoUrl" alt="Company Logo" class="border shadow-sm" style="width: 120px; height: 120px; object-fit: cover; border-radius: 999px;" />
            <div class="d-flex flex-column gap-3">
                <form asp-action="UploadLogo" method="post" enctype="multipart/form-data" class="d-flex align-items-center gap-2">
                    <input type="file" name="Logo" accept="image/*" class="form-control form-control-sm w-auto" required />
                    <button type="submit" class="btn btn-sm btn-outline-primary">Update Logo</button>
                </form>
                <form asp-action="DeleteLogo" method="post">
                    <button type="submit" class="btn btn-sm btn-outline-danger">
                        <span class="iconify" data-icon="lucide:trash-2"></span> Remove Logo
                    </button>
                </form>
            </div>
        </div>
    }
</div>

@* ── General Information Card ── *@
<div class="app-card mb-4">
    <div class="card-section-header">
        <div class="card-section-title">
            <span class="iconify" data-icon="lucide:building"></span> General Information
        </div>
        <a asp-action="EditInfo" class="btn-edit-section">
            <span class="iconify" data-icon="lucide:square-pen"></span> Edit
        </a>
    </div>
    <div class="row mt-3">
        <div class="col-md-12 mb-3">
            <div class="profile-field-label">Company Name</div>
            <div class="profile-field-value">@(string.IsNullOrEmpty(Model.CompanyName) ? "Not set" : Model.CompanyName)</div>
        </div>
        <div class="col-md-6 mb-3">
            <div class="profile-field-label">Industry</div>
            <div class="profile-field-value">
                @{
                    var hasInd = Enum.TryParse<Masar.Domain.Enums.Industries>(Model.Industry, out var indEnum);
                }
                @(hasInd ? IndustryMetadata.GetDisplayName(indEnum) : (Model.Industry ?? "Not set"))
            </div>
        </div>
        <div class="col-md-6 mb-3">
            <div class="profile-field-label">Company Size</div>
            <div class="profile-field-value">@(Model.Size?.ToString() ?? "Not set")</div>
        </div>
        <div class="col-12 mt-2">
            <div class="profile-field-label">About the Company</div>
            <div class="profile-field-value mb-0">@(string.IsNullOrEmpty(Model.Description) ? "No description provided." : Model.Description)</div>
        </div>
    </div>
</div>

@* ── Contact Information Card ── *@
<div class="app-card mb-4">
    <div class="card-section-header">
        <div class="card-section-title">
            <span class="iconify" data-icon="lucide:contact"></span> Contact Information
        </div>
        <a asp-action="EditContact" class="btn-edit-section">
            <span class="iconify" data-icon="lucide:square-pen"></span> Edit
        </a>
    </div>
    <div class="col mt-3">
        <div class="mb-3">
            <div class="profile-field-label">Email Address</div>
            <div class="profile-field-value">@(string.IsNullOrEmpty(Model.ContactEmail) ? "Not set" : Model.ContactEmail)</div>
        </div>
        <div class="mb-3">
            <div class="profile-field-label">Phone Number</div>
            <div class="profile-field-value">@(string.IsNullOrEmpty(Model.ContactPhone) ? "Not set" : Model.ContactPhone)</div>
        </div>
        <div>
            <div class="profile-field-label">Office Address</div>
            <div class="profile-field-value">@(string.IsNullOrEmpty(Model.Address) ? "Not set" : Model.Address)</div>
        </div>
    </div>
</div>

@* ── Professional Links ───────────────────────────────────── *@
<div class="app-card mb-4">
    <div class="card-section-header">
        <div class="card-section-title">
            <span class="iconify" data-icon="lucide:link-2"></span>
            Professional Links
        </div>
        <a asp-controller="Company" asp-action="EditLinks" class="btn-edit-section">
            <span class="iconify" data-icon="lucide:settings-2"></span> Manage Links
        </a>
    </div>

    @if (Model.ProfessionalLinks.Any())
    {
        <div class="d-flex flex-column gap-2">
            @foreach (var link in Model.ProfessionalLinks)
            {
                string icon = (int)link.LinkName switch
                {
                    1 => "simple-icons:linkedin",
                    2 => "simple-icons:github",
                    3 => "lucide:globe",
                    4 => "lucide:building-2",
                    _ => "lucide:link"
                };
                string color = (int)link.LinkName switch
                {
                    1 => "#0A66C2",
                    2 => "#24292E",
                    3 => "#2563EB",
                    4 => "#64748B",
                    _ => "#64748B"
                };
                string label = (int)link.LinkName switch
                {
                    1 => "LinkedIn",
                    2 => "GitHub",
                    3 => "Website",
                    4 => "Company Website",
                    _ => "Other"
                };

                <div class="d-flex align-items-center gap-3">
                    <div class="saved-link-icon-wrap">
                        <span class="iconify"
                              data-icon="@icon"
                              style="color:@color;width:1.1rem;height:1.1rem;"></span>
                    </div>
                    <span class="saved-link-name">@label</span>
                    <a href="@link.Url" target="_blank" class="saved-link-url">@link.Url</a>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-3">
            <span class="iconify"
                  data-icon="lucide:link"
                  style="width:2rem;height:2rem;color:var(--border);display:block;margin:0 auto .5rem;"></span>
            <p class="text-muted mb-2" style="font-size:.875rem;">No links added yet.</p>
        </div>
    }
</div>

@* ── Connected Service ────────────────────────────────────────────── *@
<div class="app-card mb-4">
    <div class="card-section-header">
        <div class="card-section-title">
            <span class="iconify" data-icon="lucide:shield-check"></span>
            Authentication Methods
        </div>
    </div>

    <div class="d-flex flex-column gap-3 col-12">
        @if (Model.HasLocalPassword)
        {
            <div class="connected-card-row d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-2">
                    <div class="connected-row-icon">
                        <span class="iconify" data-icon="lucide:mail"></span>
                    </div>
                    <div class="d-flex flex-column">
                        <span class="connected-row-title">Email & Password</span>
                    </div>
                </div>
                <span class="iconify connected-chevron-icon" data-icon="lucide:check"></span>
            </div>
        }

        @foreach (var provider in Model.LoginProviders)
        {
            <div class="connected-card-row d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-2">
                    <div class="connected-row-icon">
                        @* Dynamically select the icon based on the provider name *@
                        @if (provider.Equals("Google", StringComparison.OrdinalIgnoreCase))
                        {
                            <span class="iconify" data-icon="flat-color-icons:google"></span>
                        }
                        else if (provider.Equals("GitHub", StringComparison.OrdinalIgnoreCase))
                        {
                            <span class="iconify" data-icon="mdi:github" style="color: #333;"></span>
                        }
                        else
                        {
                            @* Fallback icon for other future providers *@
                            <span class="iconify" data-icon="lucide:key"></span>
                        }
                    </div>
                    <div class="d-flex flex-column">
                        <span class="connected-row-title">@provider</span>
                    </div>
                </div>
                <span class="iconify connected-chevron-icon" data-icon="lucide:check"></span>
            </div>
        }
    </div>
</div>

@* ── Account Management ────────────────────────────────────────────── *@
<div class="app-card mb-4">
    <div class="card-section-header">
        <div class="card-section-title">
            <span class="iconify" data-icon="lucide:activity"></span>
            Account Managemet
        </div>
    </div>

    <div class="d-flex flex-column gap-3 col-12">
        <a asp-controller="Company"
           asp-action="ChangePassword"
           class="security-card-row d-flex align-items-center justify-content-between">

            <div class="d-flex align-items-center">
                <div class="security-row-icon">
                    <span class="iconify"
                          data-icon="lucide:lock-keyhole"></span>
                </div>
                <div class="d-flex flex-column">
                    <span class="security-row-title">Change Password</span>
                </div>
            </div>
            <span class="iconify chevron-icon" data-icon="lucide:chevron-right"></span>
        </a>
        <a asp-controller="Company" asp-action="DeleteAccount" method="post" class="delete-card-row d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center">
                <div class="delete-row-icon">
                    <span class="iconify"
                          data-icon="lucide:trash-2"></span>
                </div>
                <div class="d-flex flex-column">
                    <span class="delete-row-title">Delete Account</span>
                </div>
            </div>
            <span class="iconify chevron-icon" data-icon="lucide:chevron-right"></span>
        </a>
    </div>
</div>