@using Masar.Domain.ViewModels.HomeDtos
@model HomePageDto

@{
    ViewData["Title"] = "Home";
    ViewData["HasFooter"] = true;

    const int carouselPageSize = 12;
    int totalCarouselPages = (int)Math.Ceiling(Model.Industries.Count / (double)carouselPageSize);
}

@section Footer {
<partial name="_Footer" />
}

@* ---------------- Hero Section ------------------ *@
<section class="hero">
    <div class="hero-inner">
        <div class="hero-content">
            <h1>
                Find  <span class="accent">Internships</span> &amp;<br />
                <span class="accent">Jobs</span> That Launch<br />
                Your  <span class="accent">Career</span>
            </h1>
            <p>Masar connects ambitious students and professionals with top companies offering internships and full-time roles. Your path. Your Future.</p>

            @* Search bar *@
            <form method="get" asp-controller="Jobs" asp-action="Index">
                <div class="jobs-search-wrap hero-search-wrap">
                    <span class="iconify jobs-search-icon" data-icon="lucide:search"></span>
                    <input type="text" name="search" class="jobs-search-input" placeholder="Search jobs, companies..." />
                    <button type="submit" class="jobs-search-btn">Search</button>
                </div>
            </form>
        </div>

        <div class="openings-panel">
            <div class="openings-header justify-content-between">
                <div class="">
                    <span class="iconify" data-icon="lucide:rss" style="width:24px;height:24px;color:var(--blue);"></span>
                    <span class="openings-title">Latest Openings</span>
                </div>
                <span class="badge-header">In the last 24 Hours</span>
            </div>

            @if (Model.LatestOpenings.Any())
            {
                @for (int i = 0; i < Model.LatestOpenings.Count; i++)
                {
                    var opening = Model.LatestOpenings[i];
                    var isLast = i == Model.LatestOpenings.Count - 1;

                    <a href="/Jobs/Details/@opening.Id" class="opening-item @(isLast ? "border-0 pb-0" : "")">

                        @* Logo or initial *@
                        <div class="company-logo" style="@(!string.IsNullOrEmpty(opening.CompanyLogo) ? "padding:0;overflow:hidden;" : "")">
                            @if (!string.IsNullOrEmpty(opening.CompanyLogo))
                            {
                                <img src="@opening.CompanyLogo" alt="@opening.CompanyName" style="width:100%;height:100%;object-fit:cover;" />
                            }
                            else
                            {
                                @(opening.CompanyName.Length > 0 ? opening.CompanyName.Substring(0, 1).ToUpper() : "?")
                            }
                        </div>

                        <div class="opening-info">
                            <div class="opening-title">@opening.Title</div>
                            <div class="opening-meta">
                                <span class="company-name">@opening.CompanyName</span>
                                @if (!string.IsNullOrEmpty(opening.SalaryDisplay))
                                {
                                    <span class="iconify dot-icon" data-icon="lucide:dot"></span>
                                    <span class="salary-text">@opening.SalaryDisplay</span>
                                }
                            </div>
                        </div>

                        <span class="badge">@opening.JobTypeDisplay</span>
                    </a>
                }
            }
            else
            {
                <div style="min-height: 420px; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 2rem;">

                    <div style="background: var(--blue-50); padding: 1rem; border-radius: 50%; margin-bottom: 1rem;">
                        <span class="iconify" data-icon="lucide:inbox" style="width: 32px; height: 32px; color: var(--blue);"></span>
                    </div>

                    <p style="font-size: 1rem; font-weight: 600; color: var(--dark); margin: 0 0 0.25rem 0;">
                        No open positions yet
                    </p>

                    <p class="text-muted" style="font-size: 0.875rem; margin: 0;">
                        We're currently gathering new opportunities. <br /> Check back later!
                    </p>

                </div>
            }
        </div>
    </div>
</section>

@* =================== Stats Bar ======================= *@
<section class="stats-bar">
    <div class="stats-inner">
        <div class="stat-item">
            <div class="stat-value">@Model.SiteStats.TotalJobsDisplay</div>
            <div class="stat-label">Jobs Posted</div>
        </div>
        <div class="stat-item">
            <div class="stat-value">@Model.SiteStats.TotalCompaniesDisplay</div>
            <div class="stat-label">Companies</div>
        </div>
        <div class="stat-item">
            <div class="stat-value">@Model.SiteStats.TotalCandidatesDisplay</div>
            <div class="stat-label">Candidates</div>
        </div>
        <div class="stat-item">
            <div class="stat-value">@Model.SiteStats.HiringRateDisplay</div>
            <div class="stat-label">Hiring Rate</div>
        </div>
    </div>
</section>

@* ==================== Browse Opportunities ==================== *@
<section class="section section-bg">
    <div class="container">
        <div class="section-header" style="text-align: center;">
            <h2 class="section-title">Browse Opportunities</h2>
            <p class="section-sub">Explore roles by your preferred industry or department</p>

            <div class="browse-toggle-wrap">
                <button type="button" class="browse-toggle-btn active" id="btn-industry" onclick="switchBrowseView('industry')">
                    <span class="iconify" data-icon="lucide:layers"></span> Industries
                </button>
                <button type="button" class="browse-toggle-btn" id="btn-department" onclick="switchBrowseView('department')">
                    <span class="iconify" data-icon="lucide:briefcase"></span> Departments
                </button>
            </div>
        </div>

        @* --- INDUSTRIES VIEW --- *@
        <div id="view-industry" class="browse-view-container">
            <div class="carousel-wrap">
                <div class="carousel-track" style="padding: 2px;">
                    @foreach (var industry in Model.Industries)
                    {
                        <a href="@Url.Action("Index", "Jobs", new { industries = industry.FilterValue })" class="industry-card">
                            <div class="industry-icon-wrap">
                                <span class="iconify" data-icon="@industry.Icon" style="width:22px;height:22px;"></span>
                            </div>
                            <div>
                                <div class="industry-name">@industry.DisplayName</div>
                                @* Using CompanyCount instead of JobCount *@
                                <div class="industry-jobs">@industry.CompanyCount Compan@(industry.CompanyCount > 1 ? "ies" : "y")</div>
                            </div>
                        </a>
                    }
                </div>
            </div>
            <div class="carousel-controls"></div>
        </div>

        @* --- DEPARTMENTS VIEW --- *@
        <div id="view-department" class="browse-view-container" style="display: none;">
            <div class="carousel-wrap">
                <div class="carousel-track" style="padding: 2px;">
                    @if (Model.Departments != null)
                    {
                        @foreach (var dept in Model.Departments)
                        {
                            <a href="@Url.Action("Index", "Jobs", new { Departments = dept.FilterValue })" class="industry-card">
                                <div class="industry-icon-wrap" style="background: var(--blue-50);">
                                    <span class="iconify" data-icon="@dept.Icon" style="width:22px;height:22px;color: var(--blue);"></span>
                                </div>
                                <div>
                                    <div class="industry-name">@dept.DisplayName</div>
                                    @* Keeps JobCount for Departments *@
                                    <div class="industry-jobs">@dept.JobCount Job@(dept.JobCount > 1 ? "s" : "")</div>
                                </div>
                            </a>
                        }
                    }
                </div>
            </div>
            <div class="carousel-controls"></div>
        </div>

    </div>
</section>

@* =========== Featured Opportunities ================== *@
<section class="section" style="background-color:white;">
    <div class="container">
        <div class="section-header-row">
            <div class="section-header-left">
                <h2 class="section-title">Featured Opportunities</h2>
                <p class="section-sub" style="text-align:left;margin-top:4px;">
                    Hand-picked roles from top-rated companies
                </p>
            </div>
            <a asp-controller="Jobs" asp-action="Index" class="view-all-link">
                View All Jobs
                <span class="iconify" data-icon="lucide:chevron-right" style="width:16px;height:16px;"></span>
            </a>
        </div>

        @if (Model.FeaturedJobs.Any())
        {
            <div class="featured-grid">
                @foreach (var job in Model.FeaturedJobs)
                {
                    var jobTypeBadgeClass = job.JobTypeDisplay switch
                    {
                        "Full-time" => "badge-fulltime",
                        "Part-time" => "badge-parttime",
                        "Internship" => "badge-internship",
                        _ => ""
                    };

                    <a asp-controller="Jobs" asp-action="Details" asp-route-id="@job.Id" class="featured-job-card">
                        <div class="job-card-head">
                            <div class="job-company-row">

                                @* Logo or initial *@
                                <div class="job-company-logo"
                                     style="@(!string.IsNullOrEmpty(job.CompanyLogo) ? "padding:0;overflow:hidden;" : "")">
                                    @if (!string.IsNullOrEmpty(job.CompanyLogo))
                                    {
                                        <img src="@job.CompanyLogo" alt="@job.CompanyName" style="width:100%;height:100%;object-fit:cover;" />
                                    }
                                    else
                                    {
                                        @(job.CompanyName.Length > 0 ? job.CompanyName.Substring(0, 1).ToUpper() : "?")
                                    }
                                </div>

                                <div>
                                    <div class="job-company-name">@job.CompanyName</div>
                                    <div class="job-company-loc">
                                        <span class="iconify" data-icon="lucide:map-pin" style="width:12px;height:12px;"></span>
                                        @job.Location
                                    </div>
                                </div>
                            </div>

                            <span class="badge @jobTypeBadgeClass">@job.JobTypeDisplay</span>
                        </div>

                        <div class="job-title">@job.Title</div>
                        <div class="job-desc">@job.Description</div>

                        <div class="job-card-footer">
                            <span class="job-salary">
                                @if (!string.IsNullOrEmpty(job.SalaryDisplay))
                                {
                                    <span class="iconify" data-icon="lucide:dollar-sign" style="width:14px;height:14px;color:var(--muted);"></span>
                                    @job.SalaryDisplay
                                }
                                else
                                {
                                    <span style="color:var(--muted);font-size:.8rem;">Salary not specified</span>
                                }
                            </span>
                            <span class="job-posted">
                                <span class="iconify" data-icon="lucide:clock" style="width:14px;height:14px;"></span>
                                @job.PostedDateDisplay
                            </span>
                        </div>
                    </a>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <span class="iconify" data-icon="lucide:briefcase" style="font-size:3rem;color:var(--border);display:block;margin:0 auto .75rem;"></span>
                <p class="text-muted">No job postings yet. Check back soon!</p>
            </div>
        }
    </div>
</section>

