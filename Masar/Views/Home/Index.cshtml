                    <div class="opening-title">Marketing Coordinator</div>
                    <div class="opening-meta">BrandCo <span class="iconify" data-icon="lucide:dot" style="width:24px;height:24px;margin: 0px -8px;"></span> $18–24/hr</div>
                </div>
                <span class="badge">Part-time</span>
            </a>

            <a href="/jobs/6" class="opening-item border-0 pb-0">
                <div class="company-logo">C</div>
                <div class="opening-info">
                    <div class="opening-title">Backend Engineer</div>
                    <div class="opening-meta">CloudSystems <span class="iconify" data-icon="lucide:dot" style="width:24px;height:24px;margin: 0px -8px;"></span> $130k–160k</div>
