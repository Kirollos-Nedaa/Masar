@section Scripts {
    <script>
        // Store our carousel instances globally so we can tell them to recalculate
        window.appCarousels = {};

        function initCarousel(viewId) {
            const container = document.getElementById(viewId);
            if (!container) return;

            const wrap = container.querySelector('.carousel-wrap');
            const track = container.querySelector('.carousel-track');
            const controls = container.querySelector('.carousel-controls');
            const cardsList = Array.from(container.querySelectorAll('.industry-card'));

            if (cardsList.length === 0) return;

            let currentPage = -1;
            let PAGE_SIZE = 12;
            let columns = 4;

            function updateLayout() {
                // Skip calculating height if the tab is currently hidden
                if (container.style.display === 'none') return;

                const isDesktop = window.innerWidth >= 768;
                if (isDesktop) { PAGE_SIZE = 12; columns = 4; }
                else { PAGE_SIZE = 6; columns = 1; }

                track.style.gridTemplateColumns = `repeat(${columns}, 1fr)`;

                // Ensure we don't land on an empty page after resizing
                const pageCount = Math.ceil(cardsList.length / PAGE_SIZE);
                let targetPage = currentPage === -1 ? 0 : currentPage;
                if (targetPage >= pageCount && pageCount > 0) targetPage = pageCount - 1;

                // 1. Update dots first so they exist
                updateDots(targetPage);

                // 2. Temporarily trick the script so it doesn't abort early
                // This ensures the active class is applied correctly even on resize
                currentPage = -1;
                showPage(targetPage);

                // 3. Update height AFTER the correct page is shown
                updateFixedHeight();
            }

            function updateDots(targetPage) {
                const pageCount = Math.ceil(cardsList.length / PAGE_SIZE);
                let dotsHTML = '';
                for (let i = 0; i < pageCount; i++) {
                    // Pre-apply the active class so it never defaults to blank
                    const activeClass = (i === targetPage) ? 'active' : '';
                    // Added type="button" to prevent weird mobile browser behaviors
                    dotsHTML += `<button type="button" class="carousel-dot ${activeClass}" data-page="${i}" aria-label="Page ${i + 1}"></button>`;
                }
                controls.innerHTML = dotsHTML;

                container.querySelectorAll('.carousel-dot').forEach((dot, i) => {
                    dot.addEventListener('click', (e) => {
                        e.preventDefault();
                        showPage(i);
                    });
                });
            }

            function updateFixedHeight() {
                // FIX: Find the first VISIBLE card. If we just check cardsList[0] while on page 2,
                // it returns a height of 0 because page 1 is hidden!
                const visibleCard = cardsList.find(c => c.style.display !== 'none') || cardsList[0];
                const cardHeight = visibleCard.offsetHeight;

                if (cardHeight === 0) return; // Failsafe

                const rows = Math.ceil(PAGE_SIZE / columns);
                const trackStyles = window.getComputedStyle(track);
                const gap = parseFloat(trackStyles.rowGap) || 14;
                const paddingTop = parseFloat(trackStyles.paddingTop) || 2;
                const paddingBottom = parseFloat(trackStyles.paddingBottom) || 2;

                const totalGapHeight = rows > 1 ? (rows - 1) * gap : 0;
                const totalPadding = paddingTop + paddingBottom;

                const height = (rows * cardHeight) + totalGapHeight + totalPadding + 1;
                wrap.style.height = `${height}px`;
            }

            function showPage(page) {
                if (page === currentPage && currentPage !== -1) return;

                let animationName = 'fadeSlideIn';
                if (currentPage !== -1) {
                    animationName = page > currentPage ? 'slideInRight' : 'slideInLeft';
                }

                currentPage = page;

                cardsList.forEach((card, i) => {
                    const cardPage = Math.floor(i / PAGE_SIZE);
                    if (cardPage === page) {
                        card.style.display = 'flex';
                        card.style.animation = 'none';
                        void card.offsetWidth; // Reflow
                        card.style.animation = `${animationName} 0.4s cubic-bezier(0.2, 0.8, 0.2, 1) both`;
                    } else {
                        card.style.display = 'none';
                    }
                });

                container.querySelectorAll('.carousel-dot').forEach((dot, i) => {
                    dot.classList.toggle('active', i === page);
                });
            }

            // Expose update layout function
            window.appCarousels[viewId] = { update: updateLayout };
            updateLayout();
        }

        // Initialize both carousels
        initCarousel('view-industry');
        initCarousel('view-department');

        // Global resize listener
        window.addEventListener('resize', () => {
            Object.values(window.appCarousels).forEach(c => c.update());
        });

        // Toggle Switch Function
        function switchBrowseView(viewName) {
            document.getElementById('btn-industry').classList.remove('active');
            document.getElementById('btn-department').classList.remove('active');
            document.getElementById('btn-' + viewName).classList.add('active');

            document.getElementById('view-industry').style.display = 'none';
            document.getElementById('view-department').style.display = 'none';

            const selectedView = document.getElementById('view-' + viewName);
            selectedView.style.display = 'block';

            // Crucial: Recalculate height now that the element is visible!
            if (window.appCarousels['view-' + viewName]) {
                window.appCarousels['view-' + viewName].update();
            }
        }
    </script>
}