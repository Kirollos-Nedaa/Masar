@section Scripts {
    <script>
        // ── Industry Carousel ──
        (function () {
            const wrap = document.querySelector('.carousel-wrap');
            const track = document.querySelector('.carousel-track');
            const controls = document.querySelector('.carousel-controls');
            const allCards = document.querySelectorAll('.industry-card');
            const cardsList = Array.from(allCards);

            let currentPage = -1;
            let PAGE_SIZE = 12; // will be updated based on breakpoint
            let columns = 4; // number of columns in grid

            // Function to update layout based on breakpoint
            function updateLayout() {
                const isDesktop = window.innerWidth >= 768;
                if (isDesktop) {
                    PAGE_SIZE = 12;
                    columns = 4;
                } else {
                    PAGE_SIZE = 6;
                    columns = 1;
                }
                // Update grid template columns on track
                track.style.gridTemplateColumns = `repeat(${columns}, 1fr)`;
                // Update dots
                updateDots();
                // Update fixed height
                updateFixedHeight();
            }

            function updateDots() {
                const pageCount = Math.ceil(cardsList.length / PAGE_SIZE);
                // Build dots HTML
                let dotsHTML = '';
                for (let i = 0; i < pageCount; i++) {
                    dotsHTML += `<button class="carousel-dot${i === 0 ? ' active' : ''}" data-page="${i}" aria-label="Page ${i + 1}"></button>`;
                }
                controls.innerHTML = dotsHTML;
                // Add click events to new dots
                document.querySelectorAll('.carousel-dot').forEach((dot, i) => {
                    dot.addEventListener('click', () => showPage(i));
                });
            }

            function updateFixedHeight() {
                if (cardsList.length === 0) return;

                const cardHeight = cardsList[0].offsetHeight;
                const rows = Math.ceil(PAGE_SIZE / columns); // Using Math.ceil ensures partial rows aren't ignored

                // 1. Grab the track element to read its live CSS
                const track = document.getElementById('carouselTrack');
                const trackStyles = window.getComputedStyle(track);

                // 2. Extract the exact gap and padding values (fallback to defaults if undefined)
                const gap = parseFloat(trackStyles.rowGap) || 14;
                const paddingTop = parseFloat(trackStyles.paddingTop) || 2;
                const paddingBottom = parseFloat(trackStyles.paddingBottom) || 2;

                // 3. Calculate total extra space
                // If there are 2 rows, there is 1 gap. If 3 rows, 2 gaps, etc.
                const totalGapHeight = rows > 1 ? (rows - 1) * gap : 0;
                const totalPadding = paddingTop + paddingBottom;

                // 4. Apply the perfect height
                const height = (rows * cardHeight) + totalGapHeight + totalPadding + 1;
                wrap.style.height = `${height}px`;
        }

            function showPage(page) {
                // Prevent animation if clicking the same active dot
                if (page === currentPage) return;

                let animationName = 'fadeSlideIn'; // Fallback for initial load

                // Determine direction based on page navigation
                if (currentPage !== -1) {
                    // Moving Forward -> Slide in from Right (Swipe Left effect)
                    // Moving Backward -> Slide in from Left (Swipe Right effect)
                    animationName = page > currentPage ? 'slideInRight' : 'slideInLeft';
                }

                currentPage = page;

                cardsList.forEach((card, i) => {
                    const cardPage = Math.floor(i / PAGE_SIZE);

                    if (cardPage === page) {
                        card.style.display = 'flex';

                        // Reset the animation so it replays every time
                        card.style.animation = 'none';
                        void card.offsetWidth; // Trigger reflow

                        // Apply the dynamic animation
                        card.style.animation = `${animationName} 0.4s cubic-bezier(0.2, 0.8, 0.2, 1) both`;
                    } else {
                        card.style.display = 'none';
                    }
                });

                // Update active dot state
                document.querySelectorAll('.carousel-dot').forEach((dot, i) => {
                    dot.classList.toggle('active', i === page);
                });
            }

            // Initialize
            updateLayout();
            // Initial render
            showPage(0);

            // Update on resize
            window.addEventListener('resize', updateLayout);
        })();
    </script>
}