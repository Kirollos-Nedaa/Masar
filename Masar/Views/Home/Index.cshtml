@{
    ViewData["Title"] = "Home";
    ViewData["HasFooter"] = true;
}

@section Footer {
    <partial name="_Footer" />
}

<section class="hero">
    <div class="hero-inner">
        <div>
            <h1>
                Find  <span class="accent">Internships</span> &amp;<br />
                <span class="accent">Jobs</span> That Launch<br />
                Your  <span class="accent">Career</span>
            </h1>
            <p>Masar connects ambitious students and professionals with top companies offering internships and full-time roles. Your path. Your Future.</p>
            <div class="hero-search">
                <input type="text" placeholder="Job title, or keywords" aria-label="Search jobs" />
                <button class="btn hero-btn-primary">Search</button>
            </div>
        </div>

        <div class="openings-panel">
            <div class="openings-header gap-2">
                <span class="iconify" data-icon="lucide:rss" style="width:24px;height:24px;"></span>
                <span class="openings-title">Latest Openings</span>
            </div>

            <a href="/jobs/1" class="opening-item">
                <div class="company-logo">T</div>
                <div class="opening-info">
                    <div class="opening-title">Frontend Developer Intern</div>
                    <div class="opening-meta">
                        TechCorp <span class="iconify" data-icon="lucide:dot" style="width:24px;height:24px;margin: 0px -8px;"></span> $25–35/hr
                    </div>
                </div>
                <span class="badge">Internship</span>
            </a>

            <a href="/jobs/2" class="opening-item">
                <div class="company-logo">S</div>
                <div class="opening-info">
                    <div class="opening-title">Software Engineer</div>
                    <div class="opening-meta">StartupXYZ <span class="iconify" data-icon="lucide:dot" style="width:24px;height:24px;margin: 0px -8px;"></span> $120k–150k</div>
                </div>
                <span class="badge">Full-time</span>
            </a>

            <a href="/jobs/3" class="opening-item">
                <div class="company-logo">D</div>
                <div class="opening-info">
                    <div class="opening-title">Product Design Intern</div>
                    <div class="opening-meta">DesignStudio <span class="iconify" data-icon="lucide:dot" style="width:24px;height:24px;margin: 0px -8px;"></span> $20–30/hr</div>
                </div>
                <span class="badge">Internship</span>
            </a>

            <a href="/jobs/5" class="opening-item">
                <div class="company-logo">B</div>
