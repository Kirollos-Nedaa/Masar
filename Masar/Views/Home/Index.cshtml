 @* ====================== How It Works ======================= *@
<section class="section section-bg">
    <div class="container">
        <div class="section-header">
            <h2 class="section-title">How Masar Works</h2>
            <p class="section-sub">Get hired in three simple steps</p>
        </div>
        <div class="steps-grid">
            <div class="steps-connector"></div>

            <div class="step-item">
                <div class="step-circle" style="background:#2563EB;">
                    <span class="iconify" data-icon="lucide:user" style="width:32px;height:32px;color:white;"></span>
                </div>
                <h3 class="step-title">Create Your Profile</h3>
                <p class="step-desc">Sign up in minutes and build a professional profile that showcases your skills, education, and experience.</p>
            </div>

            <div class="step-item">
                <div class="step-circle" style="background:#EB6B25;">
                    <span class="iconify" data-icon="lucide:search" style="width:32px;height:32px;color:white;"></span>
                </div>
                <h3 class="step-title">Discover Opportunities</h3>
                <p class="step-desc">Browse thousands of internships and jobs. Filter by industry, location, and salary to find your perfect match.</p>
            </div>

            <div class="step-item">
                <div class="step-circle" style="background:#22C55E;">
                    <span class="iconify" data-icon="lucide:trending-up" style="width:32px;height:32px;color:white;"></span>
                </div>
                <h3 class="step-title">Apply &amp; Get Hired</h3>
                <p class="step-desc">Apply with one click, track every application, and land your dream opportunity.</p>
            </div>
        </div>
    </div>
</section>

