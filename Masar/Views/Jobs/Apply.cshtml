@using Masar.Domain.ViewModels.CandidateDtos
@using Masar.Domain.ViewModels.JobDtos
@model ApplyJobViewDto

@{
    ViewData["Title"] = "Apply for Position";
    ViewData["HasFooter"] = true;
    var job = Model.Job;
    var f = Model.Form;
}

@section Footer {
    <partial name="_Footer" />
}

<div class="apply-wrap">

    <a asp-controller="Jobs" asp-action="Details" asp-route-id="@job.Id" class="apply-back-link">
        <span class="iconify" data-icon="lucide:arrow-left"></span>
        Back to Job Details
    </a>

    <h1 class="apply-page-title">Apply for Position</h1>
    <p class="apply-page-sub">Complete the form below to submit your application</p>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="epi-alert-error mb-4">
            <span class="iconify" data-icon="lucide:circle-alert"></span>
            @Html.ValidationSummary(false, null, new { @class = "mb-0" })
        </div>
    }

    <form asp-controller="Jobs" asp-action="Apply" asp-route-jobId="@job.Id"
          method="post" enctype="multipart/form-data" id="applyForm" novalidate>
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Form.JobId" value="@job.Id" />
        <input type="hidden" asp-for="Form.ExistingResumeUrl" />

        @* ── Section 1: Personal Information ─────────────── *@
        <div class="apply-section">
            <div class="apply-section-title">Personal Information</div>

            <div class="row g-3 mb-3">
                <div class="col-12 col-sm-6">
                    <label class="epi-label">First Name <span style="color:var(--red)">*</span></label>
                    <input asp-for="Form.FirstName" class="epi-input" placeholder="John" />
                </div>
                <div class="col-12 col-sm-6">
                    <label class="epi-label">Last Name <span style="color:var(--red)">*</span></label>
                    <input asp-for="Form.LastName" class="epi-input" placeholder="Doe" />
                </div>
            </div>

            <div class="mb-3">
                <label class="epi-label">Email Address <span style="color:var(--red)">*</span></label>
                <input asp-for="Form.Email" type="email" class="epi-input" placeholder="john@example.com" />
            </div>

            <div class="mb-3">
                <label class="epi-label">Phone Number <span style="color:var(--red)">*</span></label>
                <input type="hidden" asp-for="Form.PhoneNumber" id="ApplicationPhoneNumber" />
                <div class="phone-input-wrap" id="applicationPhoneWrap">
                    <div class="phone-country-btn" id="applicationCountryBtn">
                        <span id="applicationSelectedFlag">
                            <span class="iconify" data-icon="circle-flags:eg" style="font-size:1.25rem;"></span>
                        </span>
                        <span id="applicationSelectedCode">+20</span>
                        <span class="iconify phone-chevron" data-icon="lucide:chevron-down"></span>
                    </div>
                    <div class="phone-country-dropdown" id="applicationCountryDropdown" style="display:none;">
                        <div class="phone-search-wrap">
                            <span class="iconify phone-search-icon" data-icon="lucide:search"></span>
                            <input type="text" id="applicationCountrySearch" class="phone-search-input" placeholder="Search country..." onclick="event.stopPropagation()" />
                        </div>
                        <ul id="applicationCountryList" class="phone-country-list"></ul>
                    </div>
                    <input type="text" id="applicationPhoneLocal" class="epi-input phone-local-input" placeholder="010XXXXXXXX" inputmode="numeric" />
                </div>
                <span class="epi-hint">Include at least 11 digits. Leading zero is removed automatically.</span>
            </div>

            <div>
                <label class="epi-label">Current Location</label>
                <input asp-for="Form.Location" class="epi-input" placeholder="City, Country" />
            </div>
        </div>

        @* ── Section 2: Resume/CV (only if RequireCv) ────── *@
        @if (job.RequireCv)
        {
            <div class="apply-section">
                <div class="apply-section-title">
                    Resume/CV <span style="color:var(--red)">*</span>
                </div>

                @* Single hidden input replaces the radio group. JS flips its value when the candidate switches modes. *@
                <input type="hidden"
                       name="Form.UseExistingResume"
                       id="useExistingHidden"
                       value="@(!string.IsNullOrEmpty(f.ExistingResumeUrl) ? "true" : "false")" />

                @if (!string.IsNullOrEmpty(f.ExistingResumeUrl))
                {
                    @* ── Panel A: profile resume ── *@
                    <div id="existingResumePanel">
                        <div class="resume-existing-file">
                            <div class="resume-file-icon">
                                <span class="iconify" data-icon="lucide:file-text"></span>
                            </div>
                            <div>
                                <div class="resume-file-name">@(f.ExistingResumeName ?? "My Resume")</div>
                                <div class="resume-file-sub">From your profile</div>
                            </div>
                            <div class="ms-auto d-flex align-items-center gap-2 flex-shrink-0">
                                <a href="@f.ExistingResumeUrl" target="_blank" class="resume-replace-btn">
                                    <span class="iconify" data-icon="lucide:eye"></span> View
                                </a>
                                <button type="button" class="resume-replace-btn" onclick="switchToUpload()">
                                    <span class="iconify" data-icon="lucide:upload-cloud"></span>
                                    Use a different file
                                </button>
                            </div>
                        </div>
                    </div>

                    @* ── Panel B: upload zone ── *@
                    <div id="uploadNewPanel" style="display:none;">
                        <input type="file" name="resumeFile" id="resumeFile"
                               accept=".pdf,.doc,.docx" class="d-none" />
                        <div class="resume-upload-zone"
                             onclick="document.getElementById('resumeFile').click()">
                            <span class="iconify"
                                  style="font-size:2rem;display:block;margin:0 auto .5rem;color:var(--border);"
                                  data-icon="lucide:upload-cloud"></span>
                            <p class="mb-1" style="font-weight:600;">Click to upload or drag and drop</p>
                            <p class="text-muted mb-0" style="font-size:.8rem;">PDF, DOC, DOCX</p>
                        </div>
                        <p id="resumeFileName" class="resume-hint fw-bold text-success mt-2"></p>
                        <button type="button"
                                class="resume-replace-btn mt-2"
                                onclick="switchToExisting()">
                            <span class="iconify" data-icon="lucide:arrow-left"></span>
                            Use my profile resume instead
                        </button>
                    </div>
                }
                else
                {
                    @* No profile resume — show upload zone directly, no toggle needed *@
                    <input type="file" name="resumeFile" id="resumeFile"
                           accept=".pdf,.doc,.docx" class="d-none" />
                    <div class="resume-upload-zone"
                         onclick="document.getElementById('resumeFile').click()">
                        <span class="iconify"
                              style="font-size:2rem;display:block;margin:0 auto .5rem;color:var(--border);"
                              data-icon="lucide:upload-cloud"></span>
                        <p class="mb-1" style="font-weight:600;">Click to upload or drag and drop</p>
                        <p class="text-muted mb-0" style="font-size:.8rem;">PDF, DOC, DOCX</p>
                    </div>
                    <p id="resumeFileName" class="resume-hint fw-bold text-success mt-2"></p>
                }

                <p class="resume-hint mt-2">Accepted formats: PDF, DOC, DOCX (max 5MB)</p>
            </div>
        }

        @* ── Section 3: Cover Letter (only if RequireCoverLetter) *@
        @if (job.RequireCoverLetter)
        {
            <div class="apply-section">
                <div class="apply-section-title">
                    Cover Letter <span style="color:var(--red)">*</span>
                </div>

                <label class="epi-label">
                    Why are you interested in this position?
                    <span class="epi-char-count" id="clCount">0 / 2000</span>
                </label>
                <textarea asp-for="Form.CoverLetter" rows="6" class="epi-input epi-textarea"
                          placeholder="Tell us about your interest in this role, relevant experience, and what makes you a great fit..."
                          maxlength="2000" oninput="updateCount(this, 'clCount')"></textarea>
                <p class="epi-hint">Minimum 100 characters</p>
            </div>
        }

        @* ── Section 4: Additional Questions (only if job has questions) *@
        @if (Model.Questions.Any())
        {
            <div class="apply-section">
                <div class="apply-section-title">Additional Questions</div>

                @for (int i = 0; i < Model.Questions.Count; i++)
                {
                    var q = Model.Questions[i];
                    <div class="mb-4">
                        <label class="epi-label">
                            @q.QuestionText
                            @if (q.IsRequired)
                            {
                                <span style="color:var(--red)"> *</span>
                            }
                        </label>

                        @if (q.Type == "TorF")
                        {
                            <div class="apply-radio-group">
                                <label class="apply-radio-label">
                                    <input type="radio" name="Form.Answers[@i].AnswerText" value="Yes" />
                                    Yes
                                </label>
                                <label class="apply-radio-label">
                                    <input type="radio" name="Form.Answers[@i].AnswerText" value="No" />
                                    No
                                </label>
                            </div>
                        }
                        else
                        {
                            <input type="text" name="Form.Answers[@i].AnswerText" class="epi-input" placeholder="Your answer..." />
                        }

                        <input type="hidden" name="Form.Answers[@i].QuestionId" value="@q.Id" />
                    </div>
                }
            </div>
        }

        @* ── Section 5: Terms ────────────────────────────── *@
        <div class="apply-section">
            <label class="terms-check-label align-items-center">
                <input asp-for="Form.AgreeToTerms" type="checkbox" data-val="false" />
                <div>
                    <div class="terms-check-title">
                        I agree to the terms and conditions
                        <span style="color:var(--red)"> *</span>
                    </div>
                    <div class="terms-check-sub">
                        By submitting this application, I confirm that the information provided is accurate and complete.
                    </div>
                </div>
            </label>

            <label class="terms-check-label align-items-center mt-3">
                <input asp-for="Form.ConsentToDataProcessing" type="checkbox" data-val="false" />
                <div>
                    <div class="terms-check-title">
                        I consent to data processing
                        <span style="color:var(--red)"> *</span>
                    </div>
                    <div class="terms-check-sub">
                        I understand that my personal data will be processed according to the company's privacy policy.
                    </div>
                </div>
            </label>
        </div>

        @* ── Actions ──────────────────────────────────────── *@
        <div class="apply-actions">
            <a asp-controller="Jobs" asp-action="Details" asp-route-id="@job.Id" class="btn-outline-app">
                Cancel
            </a>

            <button type="submit" class="btn-primary-app" id="submitAppBtn">
                <span class="iconify" data-icon="lucide:send"></span>
                Submit Application
            </button>
        </div>

    </form>
</div>

@section Scripts {
    <script>
        function updateCount(el, id) {
            document.getElementById(id).textContent = `${el.value.length} / ${el.maxLength}`;
        }

        // ── Resume panel toggle ───────────────────────────────────────────────────
        function switchToUpload() {
            document.getElementById('existingResumePanel').style.display = 'none';
            document.getElementById('uploadNewPanel').style.display   = 'block';
            document.getElementById('useExistingHidden').value = 'false';
        }

        function switchToExisting() {
            document.getElementById('existingResumePanel').style.display = 'block';
            document.getElementById('uploadNewPanel').style.display   = 'none';
            document.getElementById('useExistingHidden').value = 'true';
            // Clear any file the candidate had selected in the upload zone
            const fi = document.getElementById('resumeFile');
            if (fi) fi.value = '';
            const label = document.getElementById('resumeFileName');
            if (label) label.textContent = '';
        }

        // Show file name when upload selected
        document.getElementById('resumeFile')?.addEventListener('change', function () {
            const nameEl = document.getElementById('resumeFileName');
            if (nameEl && this.files.length > 0) {
                nameEl.textContent = `Selected: ${this.files[0].name}`;
            } else if (nameEl) {
                nameEl.textContent = '';
            }
        });

        window.addEventListener('DOMContentLoaded', () => {
            const cl = document.querySelector('textarea[name="Form.CoverLetter"]');
            if (cl) updateCount(cl, 'clCount');

            // Phone masking initialization
            if (typeof MasarPhoneInput !== 'undefined') {
                MasarPhoneInput.init({
                    formId: 'applyForm',
                    hiddenInputId: 'ApplicationPhoneNumber',
                    localInputId: 'applicationPhoneLocal',
                    wrapperId: 'applicationPhoneWrap',
                    countryButtonId: 'applicationCountryBtn',
                    dropdownId: 'applicationCountryDropdown',
                    countryListId: 'applicationCountryList',
                    countrySearchId: 'applicationCountrySearch',
                    selectedFlagId: 'applicationSelectedFlag',
                    selectedCodeId: 'applicationSelectedCode',
                    defaultCountryIso: 'eg',
                    minDigits: 11,
                    requiredMessage: 'Phone number is required.',
                    minDigitsMessage: 'Phone number must contain at least 11 digits.'
                });
            }
        });

        // AJAX Form Submission
        document.getElementById('applyForm').addEventListener('submit', function(e) {
            e.preventDefault();
            const form = this;

            // 1. Clear ALL custom error highlights from previous submission attempts
            const dz = document.querySelector('.resume-upload-zone');
            if (dz) dz.style.border = "";

            document.querySelectorAll('.apply-radio-group').forEach(el => {
                el.style.border = "none";
                el.style.padding = "0";
            });

            // Clear borders from Phone Wrap, Text Inputs, Textareas, and Checkbox text
            const phoneWrap = document.getElementById('applicationPhoneWrap');
            if (phoneWrap) phoneWrap.style.borderColor = "";

            document.querySelectorAll('input, textarea').forEach(el => {
                if (el.type !== 'radio' && el.type !== 'file' && el.type !== 'hidden') {
                    el.style.borderColor = "";
                }
                if (el.type === 'checkbox') {
                     // Clear color specifically from the title div
                     const title = el.closest('label')?.querySelector('.terms-check-title');
                     if (title) title.style.color = "";
                }
            });

            // 2. Setup UI Feedback (Loading State)
            const btn = document.getElementById('submitAppBtn');
            const originalText = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = `<span class="iconify" data-icon="lucide:loader-2" class="spin"></span> Submitting...`;

            // 3. Send via AJAX directly to the C# Server
            const xhr = new XMLHttpRequest();
            xhr.open(form.method, form.action, true);
            xhr.setRequestHeader('X-Requested-With', 'XMLHttpRequest');

            xhr.onload = function() {
                if (xhr.status >= 200 && xhr.status < 300) {
                    try {
                        const res = JSON.parse(xhr.responseText);
                        if (res.success) {
                            showToast("Application submitted successfully!");
                            setTimeout(() => window.location.href = res.redirectUrl, 1500);
                        } else {
                            // Pop the error toast with the bulleted list
                            showToast(res.messages || res.message || "An error occurred during submission.", true);

                            // Apply RED BORDERS based on the C# server response!
                            if (res.fieldErrors) {
                                res.fieldErrors.forEach(err => {
                                    if (!err.field) return;

                                    // Special Case 1: Upload Zone
                                    if (err.field === 'resumeFile') {
                                        const dropZone = document.querySelector('.resume-upload-zone');
                                        if (dropZone) dropZone.style.border = "2px dashed var(--red)";
                                        return;
                                    }

                                    // Special Case 2: Custom Phone Number Wrapper (since the actual input is hidden)
                                    if (err.field === 'Form.PhoneNumber') {
                                        const phoneWrap = document.getElementById('applicationPhoneWrap');
                                        if (phoneWrap) {
                                            phoneWrap.style.border = "1px solid var(--red)";
                                        }
                                        return;
                                    }

                                    // General Case: Text inputs, textareas, checkboxes, and radio groups
                                    const elements = document.querySelectorAll(`[name="${err.field}"]`);
                                    elements.forEach(el => {
                                        if (el.type === 'radio') {
                                            const group = el.closest('.apply-radio-group');
                                            if (group) {
                                                group.style.border = "1px solid var(--red)";
                                                group.style.borderRadius = "8px";
                                                group.style.padding = "4px 8px";
                                            }
                                        } else if (el.type === 'checkbox') {
                                            // Turn the specific title div red
                                            const title = el.closest('label')?.querySelector('.terms-check-title');
                                            if (title) title.style.color = "var(--red)";
                                        } else {
                                            // Apply inline border explicitly to text boxes and textareas
                                            el.style.border = "1px solid var(--red)";
                                        }
                                    });
                                });
                            }
                            resetBtn();
                        }
                    } catch {
                        document.open();
                        document.write(xhr.responseText);
                        document.close();
                    }
                } else {
                    showToast("Server error: " + xhr.status, true);
                    resetBtn();
                }
            };

            xhr.onerror = function() {
                showToast("Network error. Please check your connection.", true);
                resetBtn();
            };

            xhr.send(new FormData(form));

            function resetBtn() {
                btn.disabled = false;
                btn.innerHTML = originalText;
            }
        });
    </script>
}