<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1055;"></div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
    @if (TempData["SuccessMessage"] != null)
    {
        @:window.showToast(@Html.Raw(Json.Serialize(TempData["SuccessMessage"])), false);
    }

    @if (TempData["ErrorMessage"] != null)
    {
        @:window.showToast(@Html.Raw(Json.Serialize(TempData["ErrorMessage"])), true);
    }
    });
</script>